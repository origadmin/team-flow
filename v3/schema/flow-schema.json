{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://origadmin.github.io/team-flow/schemas/v3/flow-schema.json",
  "title": "team-flow v3 Flow DSL",
  "description": "JSON Schema for team-flow v3 Flow DSL definitions",
  "type": "object",
  "required": ["version", "metadata", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "v3",
      "description": "Flow DSL version identifier"
    },
    "metadata": {
      "$ref": "#/definitions/FlowMetadata"
    },
    "config": {
      "$ref": "#/definitions/FlowConfig"
    },
    "components": {
      "$ref": "#/definitions/ComponentRegistry"
    },
    "nodes": {
      "type": "array",
      "description": "Ordered list of flow nodes",
      "items": {
        "$ref": "#/definitions/FlowNode"
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "description": "Connections between nodes defining execution order",
      "items": {
        "$ref": "#/definitions/FlowEdge"
      }
    },
    "variables": {
      "$ref": "#/definitions/FlowVariables"
    },
    "extends": {
      "type": "string",
      "description": "Reference to a base flow template for inheritance, e.g. builtin:feature-flow",
      "pattern": "^[a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+$"
    },
    "overrides": {
      "$ref": "#/definitions/FlowOverrides"
    }
  },
  "definitions": {
    "FlowMetadata": {
      "type": "object",
      "description": "Flow metadata and identification",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Flow identifier name",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable flow description"
        },
        "author": {
          "type": "string",
          "description": "Flow author or team"
        },
        "created_at": {
          "type": "string",
          "description": "ISO 8601 creation timestamp",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "description": "ISO 8601 last update timestamp",
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "description": "Classification tags for the flow",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FlowConfig": {
      "type": "object",
      "description": "Global flow execution configuration",
      "additionalProperties": false,
      "properties": {
        "task_type": {
          "type": "string",
          "description": "Task type this flow handles",
          "enum": ["feature", "bug", "change", "analysis", "docs", "hotfix", "release", "batch"]
        },
        "auto_dispatch": {
          "type": "boolean",
          "description": "Whether to automatically dispatch to the first node",
          "default": true
        },
        "parallel_limit": {
          "type": "integer",
          "description": "Maximum number of parallel branches allowed",
          "minimum": 1,
          "default": 3
        },
        "timeout_minutes": {
          "type": "integer",
          "description": "Global flow execution timeout in minutes",
          "minimum": 1
        }
      }
    },
    "FlowVariables": {
      "type": "object",
      "description": "Flow-level variables available for substitution in path/template fields",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      },
      "properties": {
        "docs_path": {
          "type": "string",
          "description": "Project documentation root path"
        },
        "TEAM_PATH": {
          "type": "string",
          "description": "Path to the .team directory"
        },
        "task_id": {
          "type": "string",
          "description": "Current task identifier"
        },
        "SKILL_PATH": {
          "type": "string",
          "description": "Path to the team-flow skill directory"
        },
        "PROJECT_PATH": {
          "type": "string",
          "description": "Project root directory path"
        }
      }
    },
    "FlowOverrides": {
      "type": "object",
      "description": "Override definitions when extending a base flow template",
      "additionalProperties": false,
      "properties": {
        "config": {
          "$ref": "#/definitions/FlowConfig"
        },
        "nodes": {
          "type": "array",
          "description": "Partial node definitions to override base flow nodes by matching id",
          "items": {
            "$ref": "#/definitions/FlowNodeOverride"
          }
        },
        "edges": {
          "type": "array",
          "description": "Replacement edges for the flow",
          "items": {
            "$ref": "#/definitions/FlowEdge"
          }
        },
        "variables": {
          "$ref": "#/definitions/FlowVariables"
        },
        "components": {
          "$ref": "#/definitions/ComponentRegistry"
        }
      }
    },
    "FlowNodeOverride": {
      "type": "object",
      "description": "Partial node definition for overriding specific fields of a base flow node",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Must match an existing node id in the base flow"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "description": "Override node config fields"
        },
        "components": {
          "$ref": "#/definitions/NodeComponents"
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DocSpec"
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GateConfig"
          }
        },
        "on_enter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          }
        },
        "on_exit": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          }
        },
        "on_error": {
          "$ref": "#/definitions/ErrorHandler"
        }
      }
    },
    "ComponentRegistry": {
      "type": "object",
      "description": "Registry of reusable components available to flow nodes",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "description": "Registered role components",
          "items": {
            "$ref": "#/definitions/RoleDefinition"
          }
        },
        "rules": {
          "type": "array",
          "description": "Registered rule components",
          "items": {
            "$ref": "#/definitions/RuleDefinition"
          }
        },
        "tools": {
          "type": "array",
          "description": "Registered tool components",
          "items": {
            "$ref": "#/definitions/ToolDefinition"
          }
        },
        "skills": {
          "type": "array",
          "description": "Registered skill components",
          "items": {
            "$ref": "#/definitions/SkillDefinition"
          }
        },
        "gates": {
          "type": "array",
          "description": "Registered gate components",
          "items": {
            "$ref": "#/definitions/GateDefinition"
          }
        }
      }
    },
    "RoleDefinition": {
      "type": "object",
      "description": "Full definition of a role component in the registry",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique role identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable role name"
        },
        "prompt_source": {
          "type": "string",
          "description": "Path to the role prompt file",
          "$ref": "#/definitions/TemplatePathString"
        },
        "standards_source": {
          "type": "string",
          "description": "Path to the role standards file",
          "$ref": "#/definitions/TemplatePathString"
        },
        "capabilities": {
          "type": "array",
          "description": "List of capability keywords for this role",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RuleDefinition": {
      "type": "object",
      "description": "Full definition of a rule component in the registry",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique rule identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable rule name"
        },
        "source": {
          "type": "string",
          "description": "Source location of the rule content"
        },
        "type": {
          "type": "string",
          "description": "Rule classification",
          "enum": ["behavioral_constraint", "output_constraint", "process_constraint", "quality_constraint"]
        },
        "enforcement": {
          "type": "string",
          "description": "Enforcement level",
          "enum": ["hard", "soft"],
          "default": "hard"
        }
      }
    },
    "ToolDefinition": {
      "type": "object",
      "description": "Full definition of a tool component in the registry",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique tool identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable tool name"
        },
        "type": {
          "type": "string",
          "description": "Tool type classification",
          "enum": ["cli", "builtin", "api", "mcp"]
        },
        "commands": {
          "type": "array",
          "description": "Available CLI commands for this tool",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "oneOf": [
            {
              "type": "string",
              "description": "Single scope identifier"
            },
            {
              "type": "array",
              "description": "List of scope identifiers",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Scope of the tool's operation"
        }
      }
    },
    "SkillDefinition": {
      "type": "object",
      "description": "Full definition of a skill component in the registry",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique skill identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable skill name"
        },
        "source": {
          "type": "string",
          "description": "Skill source location"
        },
        "trigger": {
          "type": "string",
          "description": "Activation trigger: auto, manual, or file_pattern:*.ext",
          "pattern": "^(auto|manual|file_pattern:.+)$"
        }
      }
    },
    "GateDefinition": {
      "type": "object",
      "description": "Full definition of a gate component in the registry",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique gate identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable gate name"
        },
        "source": {
          "type": "string",
          "description": "Gate source location"
        },
        "type": {
          "type": "string",
          "description": "Gate type classification",
          "enum": ["deliverable_check", "test_coverage", "lint_check", "quality_check", "custom"]
        }
      }
    },
    "FlowNode": {
      "type": "object",
      "description": "A node in the flow graph representing an execution step",
      "required": ["id", "type", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node identifier within the flow",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type": {
          "type": "string",
          "description": "Node type determining execution behavior",
          "enum": ["phase", "gate", "branch", "parallel", "subflow", "loop", "manual", "event", "terminal"]
        },
        "name": {
          "type": "string",
          "description": "Human-readable node name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Node purpose and behavior description"
        },
        "config": {
          "description": "Type-specific node configuration",
          "oneOf": [
            { "$ref": "#/definitions/PhaseConfig" },
            { "$ref": "#/definitions/GateNodeConfig" },
            { "$ref": "#/definitions/BranchConfig" },
            { "$ref": "#/definitions/ParallelConfig" },
            { "$ref": "#/definitions/SubflowConfig" },
            { "$ref": "#/definitions/LoopConfig" },
            { "$ref": "#/definitions/ManualConfig" },
            { "$ref": "#/definitions/EventConfig" },
            { "$ref": "#/definitions/TerminalConfig" }
          ]
        },
        "components": {
          "$ref": "#/definitions/NodeComponents"
        },
        "docs": {
          "type": "array",
          "description": "Document specifications this node must produce (primarily for phase nodes)",
          "items": {
            "$ref": "#/definitions/DocSpec"
          }
        },
        "gates": {
          "type": "array",
          "description": "Gate conditions to evaluate before transitioning from this node",
          "items": {
            "$ref": "#/definitions/GateConfig"
          }
        },
        "on_enter": {
          "type": "array",
          "description": "Actions to execute when entering this node",
          "items": {
            "$ref": "#/definitions/Action"
          }
        },
        "on_exit": {
          "type": "array",
          "description": "Actions to execute when exiting this node",
          "items": {
            "$ref": "#/definitions/Action"
          }
        },
        "on_error": {
          "$ref": "#/definitions/ErrorHandler"
        }
      }
    },
    "PhaseConfig": {
      "type": "object",
      "description": "Configuration for phase nodes - execution stages with assigned roles",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "description": "Role assigned to execute this phase",
          "enum": ["Triage", "TechLead", "Dev", "DevBackend", "DevFrontend", "QA", "PM", "DevOps", "Analysis", "UIDesigner", "Bugfix", "FrameworkArchitect"]
        },
        "auto_dispatch": {
          "type": "boolean",
          "description": "Whether to automatically dispatch to the assigned role",
          "default": true
        },
        "timeout_minutes": {
          "type": "integer",
          "description": "Phase execution timeout in minutes",
          "minimum": 1
        },
        "deliverables": {
          "type": "array",
          "description": "List of expected deliverable file names",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "GateNodeConfig": {
      "type": "object",
      "description": "Configuration for gate nodes - conditional checkpoints",
      "required": ["conditions"],
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "type": "array",
          "description": "Conditions to evaluate for gate pass/fail",
          "items": {
            "$ref": "#/definitions/GateCondition"
          },
          "minItems": 1
        },
        "on_pass": {
          "type": "string",
          "description": "Target node id or action keyword when all conditions pass"
        },
        "on_fail": {
          "type": "string",
          "description": "Target node id or action keyword when any condition fails"
        },
        "auto_retry": {
          "$ref": "#/definitions/AutoRetryConfig"
        }
      }
    },
    "BranchConfig": {
      "type": "object",
      "description": "Configuration for branch nodes - conditional routing",
      "required": ["conditions"],
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "type": "array",
          "description": "Ordered list of branch conditions; first match wins",
          "items": {
            "$ref": "#/definitions/BranchCondition"
          },
          "minItems": 1
        }
      }
    },
    "ParallelConfig": {
      "type": "object",
      "description": "Configuration for parallel nodes - concurrent execution",
      "required": ["branches"],
      "additionalProperties": false,
      "properties": {
        "max_concurrency": {
          "type": "integer",
          "description": "Maximum number of branches to execute concurrently",
          "minimum": 1,
          "default": 3
        },
        "strategy": {
          "type": "string",
          "description": "Parallel execution completion strategy",
          "enum": ["all_success", "any_success", "first_success", "majority_success"],
          "default": "all_success"
        },
        "branches": {
          "type": "array",
          "description": "List of parallel branch definitions",
          "items": {
            "$ref": "#/definitions/ParallelBranch"
          },
          "minItems": 1
        },
        "merge_strategy": {
          "type": "string",
          "description": "How to merge results from parallel branches",
          "enum": ["wait_all", "wait_any", "wait_majority"],
          "default": "wait_all"
        }
      }
    },
    "SubflowConfig": {
      "type": "object",
      "description": "Configuration for subflow nodes - nested flow invocation",
      "required": ["flow_ref"],
      "additionalProperties": false,
      "properties": {
        "flow_ref": {
          "type": "string",
          "description": "Reference to the sub-flow to invoke, e.g. builtin:bugfix-flow",
          "pattern": "^[a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+$"
        },
        "input_mapping": {
          "type": "object",
          "description": "Mapping of parent flow variables to sub-flow input parameters",
          "additionalProperties": {
            "type": "string"
          }
        },
        "output_mapping": {
          "type": "object",
          "description": "Mapping of sub-flow output results to parent flow variables",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "LoopConfig": {
      "type": "object",
      "description": "Configuration for loop nodes - retry/iteration with backoff",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "description": "Maximum number of loop iterations",
          "minimum": 1,
          "default": 3
        },
        "delay": {
          "type": "integer",
          "description": "Delay between iterations in seconds",
          "minimum": 0,
          "default": 0
        },
        "delay_minutes": {
          "type": "integer",
          "description": "Delay between iterations in minutes",
          "minimum": 0
        },
        "backoff": {
          "type": "string",
          "description": "Backoff strategy for delays between iterations",
          "enum": ["none", "linear", "exponential"],
          "default": "none"
        },
        "exit_condition": {
          "type": "string",
          "description": "Expression evaluated to determine early loop exit"
        }
      }
    },
    "ManualConfig": {
      "type": "object",
      "description": "Configuration for manual nodes - human approval gates",
      "required": ["approvers"],
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "type": "array",
          "description": "List of required approvers",
          "items": {
            "$ref": "#/definitions/Approver"
          },
          "minItems": 1
        },
        "approval_strategy": {
          "type": "string",
          "description": "Approval requirement strategy",
          "enum": ["all", "any", "majority"],
          "default": "all"
        },
        "timeout_minutes": {
          "type": "integer",
          "description": "Approval timeout in minutes",
          "minimum": 1
        },
        "on_timeout": {
          "type": "string",
          "description": "Action when approval times out: approve, reject, or target node id",
          "default": "reject"
        }
      }
    },
    "EventConfig": {
      "type": "object",
      "description": "Configuration for event nodes - external trigger listeners",
      "required": ["trigger"],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "$ref": "#/definitions/EventTrigger"
        },
        "timeout_minutes": {
          "type": "integer",
          "description": "Event wait timeout in minutes",
          "minimum": 1
        },
        "on_timeout": {
          "type": "string",
          "description": "Action when event times out: skip, fail, or target node id"
        }
      }
    },
    "TerminalConfig": {
      "type": "object",
      "description": "Configuration for terminal nodes - flow end states",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "description": "Terminal status indicating flow outcome",
          "enum": ["success", "failed", "rejected", "cancelled", "timeout"]
        },
        "message": {
          "type": "string",
          "description": "Optional status message or reason"
        }
      }
    },
    "DocSpec": {
      "type": "object",
      "description": "Document specification defining expected deliverables from a node",
      "required": ["name", "format", "path", "required"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Document file name, e.g. SPEC.md",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "description": "Document format (v3 uses Markdown exclusively)",
          "enum": ["markdown"],
          "default": "markdown"
        },
        "path": {
          "$ref": "#/definitions/TemplatePathString"
        },
        "template": {
          "description": "Optional template file path for document generation",
          "oneOf": [
            { "$ref": "#/definitions/TemplatePathString" },
            { "type": "null" }
          ]
        },
        "required": {
          "type": "boolean",
          "description": "Whether this document must be produced before the node can complete",
          "default": true
        },
        "description": {
          "type": "string",
          "description": "Document description serving as guidance for AI execution"
        }
      }
    },
    "TemplatePathString": {
      "type": "string",
      "description": "Path string supporting variable placeholders like {docs_path}, {TEAM_PATH}, {task_id}, {SKILL_PATH}, {PROJECT_PATH}",
      "pattern": "^(.*\\{(?:docs_path|TEAM_PATH|task_id|SKILL_PATH|PROJECT_PATH)\\}.*)|[^{}]+$"
    },
    "NodeComponents": {
      "type": "object",
      "description": "Components mounted to a node for execution context injection",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "description": "Role references activated for this node",
          "items": {
            "$ref": "#/definitions/ComponentRef"
          }
        },
        "rules": {
          "type": "array",
          "description": "Rule references loaded as constraints for this node",
          "items": {
            "$ref": "#/definitions/ComponentRef"
          }
        },
        "tools": {
          "type": "array",
          "description": "Tool references available for this node",
          "items": {
            "$ref": "#/definitions/ToolRef"
          }
        },
        "skills": {
          "type": "array",
          "description": "Skill references activated for this node",
          "items": {
            "$ref": "#/definitions/ComponentRef"
          }
        },
        "prompts": {
          "type": "array",
          "description": "Prompt references loaded for this node",
          "items": {
            "$ref": "#/definitions/ComponentRef"
          }
        },
        "constraints": {
          "type": "array",
          "description": "Behavioral constraints enforced on this node",
          "items": {
            "$ref": "#/definitions/Constraint"
          }
        }
      }
    },
    "ComponentRef": {
      "type": "object",
      "description": "Unified reference to a registered component",
      "required": ["ref", "source"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Component identifier matching a registry entry",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "description": "Component origin",
          "enum": ["builtin", "custom", "marketplace", "trae", "file", "framework"]
        },
        "version": {
          "type": "string",
          "description": "Optional component version, e.g. 1.0.0",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {
          "type": "string",
          "description": "File path when source is file; supports variable placeholders",
          "$ref": "#/definitions/TemplatePathString"
        },
        "config": {
          "type": "object",
          "description": "Optional configuration overrides for the component",
          "additionalProperties": true
        }
      }
    },
    "ToolRef": {
      "type": "object",
      "description": "Reference to a tool with optional command and scope restrictions",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Tool identifier matching a registry entry",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "description": "Tool origin",
          "enum": ["builtin", "custom", "marketplace", "trae", "file", "framework"]
        },
        "version": {
          "type": "string",
          "description": "Optional tool version",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {
          "type": "string",
          "description": "File path when source is file",
          "$ref": "#/definitions/TemplatePathString"
        },
        "config": {
          "type": "object",
          "description": "Optional configuration for the tool",
          "additionalProperties": true
        },
        "commands": {
          "type": "array",
          "description": "Allowed CLI commands for this tool reference",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string",
          "description": "Scope restriction for the tool",
          "enum": ["codebase", "docs", "config", "all"]
        }
      }
    },
    "Constraint": {
      "type": "object",
      "description": "Behavioral constraint enforced on a node",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "Constraint type",
          "enum": ["file_write", "tool_restriction", "timeout", "max_sub_agents", "custom"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "file_write" }
            }
          },
          "then": {
            "required": ["allowed_paths"],
            "properties": {
              "allowed_paths": {
                "type": "array",
                "description": "Allowed file write path prefixes",
                "items": {
                  "$ref": "#/definitions/TemplatePathString"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "tool_restriction" }
            }
          },
          "then": {
            "properties": {
              "forbidden": {
                "type": "array",
                "description": "Tool names forbidden in this node",
                "items": {
                  "type": "string"
                }
              },
              "allowed": {
                "type": "array",
                "description": "Tool names allowed in this node (whitelist mode)",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "timeout" }
            }
          },
          "then": {
            "required": ["minutes"],
            "properties": {
              "minutes": {
                "type": "integer",
                "description": "Timeout in minutes",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "max_sub_agents" }
            }
          },
          "then": {
            "required": ["limit"],
            "properties": {
              "limit": {
                "type": "integer",
                "description": "Maximum number of sub-agent calls",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "GateConfig": {
      "type": "object",
      "description": "Gate condition configuration for validating node completion",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "Gate condition type",
          "enum": ["deliverable_check", "tests_pass", "lint_pass", "no_regressions", "quality_check", "custom"]
        },
        "on_fail": {
          "type": "string",
          "description": "Action or target node id when gate fails"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "deliverable_check" }
            }
          },
          "then": {
            "required": ["required"],
            "properties": {
              "required": {
                "type": "array",
                "description": "List of required deliverable file names",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "tests_pass" }
            }
          },
          "then": {
            "properties": {
              "threshold": {
                "type": "string",
                "description": "Required test pass threshold, e.g. 100%",
                "pattern": "^[0-9]+%$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "lint_pass" }
            }
          },
          "then": {
            "properties": {
              "threshold": {
                "type": "string",
                "description": "Maximum allowed lint errors, e.g. 0 errors",
                "pattern": "^[0-9]+ errors?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "no_regressions" }
            }
          },
          "then": {
            "properties": {
              "check": {
                "type": "string",
                "description": "Command or method to check for regressions"
              }
            }
          }
        }
      ]
    },
    "GateCondition": {
      "type": "object",
      "description": "Individual condition within a gate node",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "Condition evaluation type",
          "enum": [
            "tests_pass",
            "lint_pass",
            "deliverables_complete",
            "no_regressions",
            "task_exists",
            "type_matches",
            "custom"
          ]
        },
        "threshold": {
          "type": "string",
          "description": "Pass threshold value"
        },
        "required": {
          "type": "array",
          "description": "Required items for deliverable checks",
          "items": {
            "type": "string"
          }
        },
        "check": {
          "type": "string",
          "description": "Command or method for regression checks"
        },
        "expected": {
          "type": "string",
          "description": "Expected value for type_matches condition"
        }
      }
    },
    "BranchCondition": {
      "type": "object",
      "description": "Condition for branch routing",
      "properties": {
        "when": {
          "type": "string",
          "description": "Expression to evaluate, e.g. task.type == 'feature'"
        },
        "goto": {
          "type": "string",
          "description": "Target node id when condition matches"
        },
        "default": {
          "type": "string",
          "description": "Marks this as the default branch",
          "enum": ["goto"]
        },
        "target": {
          "type": "string",
          "description": "Target node id for default branch (used with default: goto)"
        }
      }
    },
    "ParallelBranch": {
      "type": "object",
      "description": "A single branch within a parallel node",
      "required": ["node"],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "description": "Target node id to execute in this branch"
        },
        "weight": {
          "type": "integer",
          "description": "Relative weight for resource allocation",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "Approver": {
      "type": "object",
      "description": "Approver definition for manual nodes",
      "required": ["role"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "description": "Role required to approve, e.g. TechLead"
        },
        "user": {
          "type": "string",
          "description": "Specific user identifier (alternative to role)"
        },
        "required": {
          "type": "boolean",
          "description": "Whether this approver is mandatory",
          "default": true
        }
      }
    },
    "EventTrigger": {
      "type": "object",
      "description": "Event trigger definition for event nodes",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Trigger type",
          "enum": ["webhook", "file_change", "schedule", "task_status", "manual", "custom"]
        },
        "pattern": {
          "type": "string",
          "description": "Pattern for matching trigger events, e.g. file glob or webhook path"
        },
        "filter": {
          "type": "object",
          "description": "Additional filter criteria for the trigger",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },
    "AutoRetryConfig": {
      "type": "object",
      "description": "Automatic retry configuration for gate failures",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "description": "Maximum number of retry attempts",
          "minimum": 1,
          "default": 2
        },
        "delay_minutes": {
          "type": "integer",
          "description": "Delay between retry attempts in minutes",
          "minimum": 0,
          "default": 5
        }
      }
    },
    "Action": {
      "type": "object",
      "description": "An action to execute on node lifecycle events",
      "required": ["action"],
      "additionalProperties": true,
      "properties": {
        "action": {
          "type": "string",
          "description": "Action type identifier",
          "enum": [
            "update_task_phase",
            "notify",
            "log",
            "set_variable",
            "invoke_tool",
            "custom"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": { "const": "update_task_phase" }
            }
          },
          "then": {
            "required": ["phase"],
            "properties": {
              "phase": {
                "type": "string",
                "description": "New task phase value"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": { "const": "notify" }
            }
          },
          "then": {
            "required": ["message"],
            "properties": {
              "message": {
                "type": "string",
                "description": "Notification message"
              },
              "channel": {
                "type": "string",
                "description": "Notification channel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": { "const": "set_variable" }
            }
          },
          "then": {
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Variable name to set"
              },
              "value": {
                "description": "Variable value",
                "type": ["string", "number", "boolean"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": { "const": "invoke_tool" }
            }
          },
          "then": {
            "required": ["tool", "command"],
            "properties": {
              "tool": {
                "type": "string",
                "description": "Tool reference id"
              },
              "command": {
                "type": "string",
                "description": "Tool command to invoke"
              },
              "args": {
                "type": "object",
                "description": "Command arguments",
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "ErrorHandler": {
      "type": "object",
      "description": "Error handling configuration for a node",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "description": "Error handling strategy",
          "enum": ["retry", "skip", "fail", "fallback"],
          "default": "fail"
        },
        "max_retries": {
          "type": "integer",
          "description": "Maximum retry attempts when strategy is retry",
          "minimum": 0,
          "default": 0
        },
        "retry_delay_seconds": {
          "type": "integer",
          "description": "Delay between retries in seconds",
          "minimum": 0
        },
        "fallback_node": {
          "type": "string",
          "description": "Target node id when strategy is fallback"
        },
        "on_error": {
          "type": "array",
          "description": "Actions to execute on error",
          "items": {
            "$ref": "#/definitions/Action"
          }
        }
      }
    },
    "FlowEdge": {
      "type": "object",
      "description": "Directed edge connecting two nodes in the flow graph",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique edge identifier"
        },
        "from": {
          "type": "string",
          "description": "Source node id"
        },
        "to": {
          "type": "string",
          "description": "Target node id"
        },
        "type": {
          "type": "string",
          "description": "Edge type determining traversal semantics",
          "enum": ["sequential", "conditional"],
          "default": "sequential"
        },
        "conditions": {
          "type": "array",
          "description": "Conditions required for conditional edges",
          "items": {
            "$ref": "#/definitions/EdgeCondition"
          }
        }
      }
    },
    "EdgeCondition": {
      "type": "object",
      "description": "Condition for conditional edge traversal",
      "required": ["expression"],
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string",
          "description": "Boolean expression to evaluate, e.g. gate.passed == true"
        }
      }
    }
  }
}
