{
  "version": "v3",
  "metadata": {
    "name": "dev-flow",
    "description": "Software development main flow: Triage → Branch by task_type → Feature/Bugfix/Hotfix/Analysis/Change → Terminal",
    "author": "team-flow",
    "tags": [
      "development",
      "main-flow",
      "software"
    ]
  },
  "config": {
    "task_type": "development",
    "auto_dispatch": true,
    "parallel_limit": 3,
    "timeout_minutes": 480
  },
  "variables": {
    "docs_path": "",
    "TEAM_PATH": "",
    "task_id": "",
    "SKILL_PATH": "",
    "workspace": "",
    "domain": "development"
  },
  "components": {
    "roles": [
      {
        "id": "triage",
        "name": "Triage Agent",
        "description": "Classify and dispatch tasks",
        "capabilities": [
          "classify",
          "dispatch"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/triage.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/triage-standards.md",
        "prompt_directives": [
          "Dispatch tasks to sub-agents, never execute directly",
          "Classify all user input before action: Feature/Bug/Change/Analysis/Batch",
          "Read .team/project.md for project constraints before dispatch",
          "Use flow task create/show for all task state management",
          "Report deliverables and handoff to next role on completion"
        ]
      },
      {
        "id": "tech-lead",
        "name": "Tech Lead",
        "description": "Design and review",
        "capabilities": [
          "analyze",
          "design",
          "review"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/tech-lead.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/architecture-standards.md",
        "prompt_directives": [
          "Design before implement: SPEC.md + AC.md + Data Model mandatory",
          "Ensure R0 Navigation Matrix covers all entry points",
          "Review all API contracts for consistency",
          "Verify design satisfies all acceptance criteria",
          "Output Guard self-check before marking phase complete"
        ]
      },
      {
        "id": "dev",
        "name": "Developer",
        "description": "Implement code",
        "capabilities": [
          "implement",
          "test",
          "debug"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/dev.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/development-standards.md",
        "prompt_directives": [
          "Read SCOPE.md before starting implementation",
          "Surgical changes only: never modify files outside task scope",
          "Run tests before marking phase complete",
          "No Chinese comments or commit messages",
          "Never delete files unless explicitly asked",
          "Output Guard 5-step self-check mandatory before completion gate"
        ]
      },
      {
        "id": "qa",
        "name": "QA Engineer",
        "description": "Verify and validate",
        "capabilities": [
          "verify",
          "test",
          "validate"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/qa-engineer.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/test-standards.md",
        "prompt_directives": [
          "Verify implementation matches SPEC.md and AC.md",
          "Run full regression tests, not just new tests",
          "Check front-back interface consistency (paths, params, response)",
          "For bugfixes: data flow trace + real scenario verification required",
          "Output Guard self-check before marking review complete"
        ]
      },
      {
        "id": "devops",
        "name": "DevOps",
        "description": "Deploy and monitor",
        "capabilities": [
          "deploy",
          "monitor"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/devops.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/devops-standards.md",
        "prompt_directives": [
          "Verify CI pipeline passes before any deployment",
          "Always have rollback plan before deployment",
          "Check Docker image build success",
          "Run smoke tests after deployment",
          "Update CHANGELOG and version number"
        ]
      },
      {
        "id": "analysis",
        "name": "Analyst",
        "description": "Analyze and research",
        "capabilities": [
          "analyze",
          "research"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/analysis.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/analysis-standards.md"
      }
    ],
    "rules": [
      {
        "id": "dispatch-guard",
        "name": "Dispatch Guard",
        "description": "Triage must dispatch, never execute directly",
        "source": "builtin",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "output-guard",
        "name": "Output Guard Protocol",
        "description": "5-step self-assessment before completion",
        "source": "framework",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "regression-guard",
        "name": "Regression Prevention",
        "description": "Prevent regressions in existing functionality",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "hard-constraints",
        "name": "Hard Constraints",
        "description": "No file deletion, no PowerShell Set-Content/Out-File, no skip toolchain gate",
        "source": "builtin",
        "type": "behavioral_constraint",
        "enforcement": "hard"
      },
      {
        "id": "development-standards",
        "name": "Development Standards",
        "description": "No Chinese comments/commits, TDD, no BOM-polluting tools",
        "source": "builtin",
        "type": "behavioral_constraint",
        "enforcement": "hard"
      },
      {
        "id": "test-standards",
        "name": "Test Standards",
        "description": "Unit tests pass, coverage report required",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "review-standards",
        "name": "Review Standards",
        "description": "Architecture compliance, SCOPE.md generation",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "requirements-standards",
        "name": "Requirements Standards",
        "description": "SPEC must include scope, constraints, and measurable acceptance criteria",
        "source": "builtin",
        "type": "output_constraint",
        "enforcement": "hard"
      },
      {
        "id": "architecture-standards",
        "name": "Architecture Standards",
        "description": "Design artifacts must follow R1-R3 format",
        "source": "builtin",
        "type": "output_constraint",
        "enforcement": "hard"
      },
      {
        "id": "loop-guard",
        "name": "Loop Guard",
        "description": "Prevent infinite loops in iterative processes; max 3 iterations before escalation",
        "source": "builtin",
        "type": "process_constraint",
        "enforcement": "hard"
      }
    ],
    "tools": [
      {
        "id": "task",
        "name": "Task CLI",
        "type": "cli",
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ]
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ],
    "skills": [
      {
        "id": "api-design",
        "name": "API Design",
        "source": "builtin",
        "trigger": "manual",
        "path": "{TEAM_PATH}/skills/api-design/SKILL.md",
        "description": "Design RESTful/gRPC API contracts with consistent naming and error handling"
      },
      {
        "id": "protobuf",
        "name": "Protobuf",
        "source": "builtin",
        "trigger": "manual",
        "path": "{TEAM_PATH}/skills/protobuf/SKILL.md",
        "description": "Protocol Buffer schema design and code generation"
      }
    ]
  },
  "nodes": [
    {
      "id": "tri3",
      "type": "phase",
      "name": "Task Triage",
      "description": "Classify incoming task by type and dispatch to the appropriate branch",
      "config": {
        "role": "Triage"
      },
      "components": {
        "roles": [
          {
            "ref": "triage",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "dispatch-guard",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "triage",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/triage.md"
          }
        ]
      },
      "docs": [
        {
          "name": "TRIAGE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/TRIAGE.md",
          "required": true,
          "description": "Triage classification record with task type, priority, scope assessment, and dispatch decision"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ]
    },
    {
      "id": "ent7",
      "type": "gate",
      "name": "Entry Gate",
      "description": "Validate task has sufficient context and matches a known task type",
      "config": {
        "conditions": [
          {
            "type": "task_exists",
            "required": true,
            "check": "Verify a beads task exists for this request"
          },
          {
            "type": "context_sufficient",
            "required": true,
            "check": "Task description contains enough detail to proceed",
            "threshold": "minimal"
          },
          {
            "type": "type_identified",
            "required": false,
            "check": "Task type can be determined from context"
          }
        ]
      }
    },
    {
      "id": "fa01",
      "type": "phase",
      "name": "Requirements Analysis",
      "description": "Analyze feature requirements and produce specification with acceptance criteria",
      "config": {
        "role": "TechLead"
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "requirements-standards",
            "source": "builtin"
          },
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "skills": [
          {
            "ref": "api-design",
            "source": "builtin"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{docs_path}/{task_id}/"
            ]
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ]
      },
      "docs": [
        {
          "name": "SPEC.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/SPEC.md",
          "required": true,
          "description": "Feature specification: requirements, scope, constraints, data models, API contracts",
          "content_rules": [
            "Must contain: overview, requirements, constraints, dependencies"
          ]
        },
        {
          "name": "AC.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/AC.md",
          "required": true,
          "description": "Acceptance criteria: measurable conditions for feature completion with Given-When-Then format",
          "content_rules": [
            "Must contain: acceptance criteria as testable assertions",
            "Each criterion must be verifiable (pass/fail)"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "fd02",
      "type": "phase",
      "name": "Technical Design",
      "description": "Design data models, state machines, and API contracts based on requirements",
      "config": {
        "role": "TechLead"
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "architecture-standards",
            "source": "builtin"
          }
        ],
        "skills": [
          {
            "ref": "protobuf",
            "source": "builtin"
          },
          {
            "ref": "api-design",
            "source": "builtin"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{docs_path}/{task_id}/"
            ]
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ]
      },
      "docs": [
        {
          "name": "R1_DATA_MODEL.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/R1_DATA_MODEL.md",
          "required": true,
          "description": "Data model design: entity relationships, schema definitions, index strategy"
        },
        {
          "name": "R2_STATE_MACHINE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/R2_STATE_MACHINE.md",
          "required": true,
          "description": "State machine design: transitions, events, lifecycle, error states"
        },
        {
          "name": "R3_API_CONTRACT.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/R3_API_CONTRACT.md",
          "required": true,
          "description": "API contract: endpoints, request/response schemas, error codes, versioning"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "design"
        }
      ]
    },
    {
      "id": "fi03",
      "type": "phase",
      "name": "Implementation",
      "description": "Implement the feature code and unit tests following the technical design",
      "config": {
        "role": "Dev"
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "development-standards",
            "source": "builtin"
          },
          {
            "ref": "regression-guard",
            "source": "builtin"
          },
          {
            "ref": "loop-guard",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-write"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{workspace}/"
            ]
          },
          {
            "type": "tool_restriction",
            "forbidden": [
              "shell-exec"
            ]
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "IMPL.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/IMPL.md",
          "required": true,
          "description": "Implementation notes: key code changes, architectural decisions, test coverage summary"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "bi01",
      "type": "phase",
      "name": "Root Cause Investigation",
      "description": "Investigate the bug, identify root cause, and produce RCA document",
      "config": {
        "role": "Dev"
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "development-standards",
            "source": "builtin"
          },
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "RCA.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/RCA.md",
          "required": true,
          "description": "Root cause analysis: bug origin, affected components, reproduction steps, severity assessment",
          "content_rules": [
            "Must contain: phenomenon, root_cause, impact, prevention",
            "Data flow trace required for API/permission/state bugs",
            "Real scenario verification required (not mock-only)"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "bf02",
      "type": "phase",
      "name": "Bug Fix",
      "description": "Implement the bug fix and add regression tests",
      "config": {
        "role": "Dev"
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "development-standards",
            "source": "builtin"
          },
          {
            "ref": "regression-guard",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-write"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{workspace}/"
            ]
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "FIX.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/FIX.md",
          "required": true,
          "description": "Bug fix notes: fix approach, code changes, regression test additions, verification steps"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "hi01",
      "type": "phase",
      "name": "Emergency Fix",
      "description": "Implement the emergency hotfix with minimal scope",
      "config": {
        "role": "Dev"
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "development-standards",
            "source": "builtin"
          },
          {
            "ref": "regression-guard",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-write"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{workspace}/"
            ]
          },
          {
            "type": "timeout",
            "minutes": 60
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "RCA.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/RCA.md",
          "required": true,
          "description": "Emergency RCA: incident timeline, root cause, fix description, post-incident actions",
          "content_rules": [
            "Must contain: phenomenon, root_cause, impact, prevention",
            "Data flow trace required for API/permission/state bugs",
            "Real scenario verification required (not mock-only)"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ],
      "on_error": {
        "strategy": "fail",
        "on_error": [
          {
            "action": "notify",
            "message": "Hotfix implementation failed - escalation required",
            "channel": "emergency"
          }
        ]
      }
    },
    {
      "id": "ai01",
      "type": "phase",
      "name": "Deep Analysis",
      "description": "Perform technical analysis and gather findings",
      "config": {
        "role": "Analysis"
      },
      "components": {
        "roles": [
          {
            "ref": "analysis",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "analysis",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/analysis.md"
          }
        ]
      },
      "docs": [
        {
          "name": "FINDINGS.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/FINDINGS.md",
          "required": true,
          "description": "Analysis findings: investigation results, evidence, patterns, technical insights"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "ar02",
      "type": "phase",
      "name": "Analysis Report",
      "description": "Compile analysis results into a structured report with conclusions",
      "config": {
        "role": "Analysis"
      },
      "components": {
        "roles": [
          {
            "ref": "analysis",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "prompts": [
          {
            "ref": "analysis",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/analysis.md"
          }
        ]
      },
      "docs": [
        {
          "name": "REPORT.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/REPORT.md",
          "required": true,
          "description": "Final analysis report: conclusions, recommendations, action items, risk assessment"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "review"
        }
      ]
    },
    {
      "id": "cp01",
      "type": "phase",
      "name": "Change Planning",
      "description": "Plan the change scope, impact analysis, and migration strategy",
      "config": {
        "role": "TechLead"
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "architecture-standards",
            "source": "builtin"
          },
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{docs_path}/{task_id}/"
            ]
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ]
      },
      "docs": [
        {
          "name": "SCOPE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/SCOPE.md",
          "required": true,
