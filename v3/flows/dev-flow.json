  "metadata": {
    "author": "team-flow",
    "description": "Router flow: Triage → Entry Gate → Route to sub-flow (feature/bugfix/hotfix/analysis/change) → Quality Gate → Verify → Review → Terminal",
    "name": "dev-flow",
    "tags": [
      "development",
      "main-flow",
      "router",
      "software"
    ]
  },
  "nodes": [
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/triage.md",
            "ref": "triage",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "triage",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d1a",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "commands": [
              "show",
              "update",
              "append"
            ],
            "ref": "task"
          },
          {
            "ref": "search"
          }
        ]
      },
      "config": {
        "role": "Triage"
      },
      "description": "Classify incoming task by type and dispatch to the appropriate branch",
      "docs": [
        {
          "description": "Triage classification record with task type, priority, scope assessment, and dispatch decision",
          "format": "markdown",
          "name": "TRIAGE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/TRIAGE.md",
          "required": true
        }
      ],
      "id": "tri3",
      "name": "Task Triage",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "check": "Project context has been verified via flow project detect",
            "required": true,
            "type": "project_context_verified"
          },
          {
            "check": "Working directory is within PROJECT_ROOT or its subdirectories",
            "required": true,
            "type": "path_match"
          },
          {
            "check": "Verify a task exists for this request (flow task or file-based)",
            "required": true,
            "type": "task_exists"
          },
          {
            "check": "Task description contains enough detail to proceed",
            "required": true,
            "threshold": "minimal",
            "type": "context_sufficient"
          },
          {
            "check": "Task type can be determined from context",
            "required": false,
            "type": "type_identified"
          }
        ]
      },
      "description": "Validate task has sufficient context and matches a known task type. Also validates project context (path match and project confirmed).",
      "id": "ent7",
      "name": "Entry Gate",
      "type": "gate"
    },
    {
      "config": {
        "flow_ref": "builtin:feature-flow"
      },
      "description": "Feature development sub-flow: Analysis → Design → Implementation",
      "id": "sf-feat",
      "name": "Feature Flow",
      "type": "subflow"
    },
    {
      "config": {
        "flow_ref": "builtin:bugfix-flow"
      },
      "description": "Bug fix sub-flow: Root Cause → Fix → Verify",
      "id": "sf-bug",
      "name": "Bugfix Flow",
      "type": "subflow"
    },
    {
      "config": {
        "flow_ref": "builtin:hotfix-flow"
      },
      "description": "Emergency hotfix sub-flow: Rapid fix with minimal scope",
      "id": "sf-hotfix",
      "name": "Hotfix Flow",
      "type": "subflow"
    },
    {
      "config": {
        "flow_ref": "builtin:analysis-flow"
      },
      "description": "Analysis sub-flow: Investigation → Report",
      "id": "sf-analysis",
      "name": "Analysis Flow",
      "type": "subflow"
    },
    {
      "config": {
        "flow_ref": "builtin:change-flow"
      },
      "description": "Change sub-flow: Planning → Execution",
      "id": "sf-change",
      "name": "Change Flow",
      "type": "subflow"
    },
    {
      "config": {
        "auto_retry": {
          "delay_minutes": 5,
          "max_attempts": 2
        },
        "conditions": [
          {
            "check": "All unit and integration tests pass",
            "required": true,
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "check": "No lint errors in changed files",
            "required": true,
            "threshold": "0 errors",
            "type": "lint_pass"
          },
          {
            "check": "No regressions in existing functionality",
            "required": false,
            "type": "no_regressions"
          }
        ]
      },
      "description": "Verify code quality: tests pass, lint clean, no regressions",
      "id": "qua9",
      "name": "Quality Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/qa-engineer.md",
            "ref": "qa",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "qa",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d6g",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "role": "QA"
      },
      "description": "Run full integration and E2E tests, verify completeness",
      "docs": [
        {
          "description": "Test coverage report: unit, integration, and E2E test results with coverage metrics",
          "format": "markdown",
          "name": "TEST_COVERAGE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/TEST_COVERAGE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/feature-test-template.md"
        }
      ],
      "id": "ver4",
      "name": "Integration Verification",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ],
      "type": "phase"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/tech-lead.md",
            "ref": "tech-lead",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "tech-lead",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d7h",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "role": "TechLead"
      },
      "description": "Review code quality, architecture compliance, and produce completion scope",
      "docs": [
        {
          "content_rules": [
            "Must contain: changed files, added files, deleted files, risk assessment"
          ],
          "description": "Completion scope: what was implemented, changed, known issues, and verification notes",
          "format": "markdown",
          "name": "SCOPE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/SCOPE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/scope-template.md"
        }
      ],
      "id": "rev6",
      "name": "Code Review",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "review"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "message": "Task completed successfully",
        "status": "success"
      },
      "description": "Task completed successfully",
      "id": "suc0",
      "name": "Completed",
      "type": "terminal"
    },
    {
      "config": {
        "message": "Task does not meet minimum requirements",
        "status": "rejected"
      },
      "description": "Task rejected at entry gate",
      "id": "rej8",
      "name": "Rejected",
      "type": "terminal"
    },
    {
      "config": {
        "message": "Task failed - manual intervention required",
        "status": "failed"
      },
      "description": "Task failed and requires manual escalation",
      "id": "fai3",
      "name": "Failed",
      "type": "terminal"
    }
  ],
  "variables": {
    "DOCS_INTERNAL": "",
    "SKILL_PATH": "",
    "TEAM_PATH": "",
    "domain": "development",
    "task_id": "",
    "workspace": ""
  },
  "version": "v3"
}
