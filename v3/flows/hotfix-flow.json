{
  "components": {
    "roles": [],
    "rules": [],
    "skills": [],
    "tools": [
      {
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ],
        "id": "task",
        "name": "Task CLI",
        "type": "cli"
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ]
  },
  "config": {
    "auto_dispatch": true,
    "parallel_limit": 1,
    "task_type": "hotfix",
    "timeout_minutes": 60
  },
  "edges": [
    {
      "from": "phase-triage",
      "id": "e-triage-gate",
      "to": "gate-entry"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-fix",
      "to": "phase-fix",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-reject",
      "to": "terminal-reject",
      "type": "conditional"
    },
    {
      "from": "phase-fix",
      "id": "e-fix-gate",
      "to": "gate-quality"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-quality",
      "id": "e-gate-verify",
      "to": "phase-verify",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-quality",
      "id": "e-gate-fix-retry",
      "to": "phase-fix",
      "type": "conditional"
    },
    {
      "from": "phase-verify",
      "id": "e-verify-completion",
      "to": "gate-completion"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-success",
      "to": "terminal-success",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-verify",
      "to": "phase-verify",
      "type": "conditional"
    }
  ],
  "metadata": {
    "author": "team-flow",
    "description": "Emergency hotfix flow: Triage → Gate → Fix → Quality Gate → Verify → Completion Gate → Terminal",
    "name": "hotfix-flow",
    "tags": [
      "hotfix",
      "emergency",
      "software"
    ]
  },
  "nodes": [
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/triage.md",
            "ref": "triage",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "triage",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d1a",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "role": "Triage"
      },
      "description": "Classify and validate the emergency hotfix request",
      "docs": [
        {
          "description": "Hotfix triage record with severity assessment, impact scope, and dispatch decision",
          "format": "markdown",
          "name": "TRIAGE.md",
          "path": "{DOCS_INTERNAL}/{task_id}/TRIAGE.md",
          "required": true
        }
      ],
      "id": "phase-triage",
      "name": "Hotfix Triage",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "type": "task_exists"
          },
          {
            "expected": "hotfix",
            "type": "type_matches"
          }
        ],
        "on_fail": "terminal-reject",
        "on_pass": "phase-fix"
      },
      "description": "Validate hotfix request is genuine emergency",
      "id": "gate-entry",
      "name": "Entry Gate",
      "type": "gate"
    },
    {
      "components": {
        "constraints": [
          {
            "allowed_paths": [
              "{workspace}/"
            ],
            "type": "file_write"
          },
          {
            "minutes": 60,
            "type": "timeout"
          }
        ],
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/dev.md",
            "ref": "dev",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "dev",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d5f",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          },
          {
            "ref": "d4e",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-ops"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "RCA.md",
          "code",
          "regression_tests"
        ],
        "role": "Dev"
      },
      "description": "Implement the emergency hotfix with minimal scope",
      "docs": [
        {
          "content_rules": [
            "Must contain: phenomenon, root_cause, impact, prevention",
            "Data flow trace required for API/permission/state bugs",
            "Real scenario verification required (not mock-only)"
          ],
          "description": "Emergency RCA: incident timeline, root cause, fix description, post-incident actions",
          "format": "markdown",
          "name": "RCA.md",
          "path": "{DOCS_INTERNAL}/{task_id}/RCA.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/bug-test-template.md"
        }
      ],
      "id": "phase-fix",
      "name": "Emergency Fix",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ],
      "on_error": {
        "on_error": [
          {
            "action": "notify",
            "channel": "emergency",
            "message": "Hotfix implementation failed - escalation required"
          }
        ],
        "strategy": "fail"
      },
      "type": "phase"
    },
    {
      "config": {
        "auto_retry": {
          "delay_minutes": 2,
          "max_attempts": 2
        },
        "conditions": [
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "threshold": "0 errors",
            "type": "lint_pass"
          },
          {
            "type": "no_regressions"
          },
          {
            "check": "Regression tests added for the fix",
            "required": true,
            "type": "custom"
          },
          {
            "check": "RCA.md contains: phenomenon, root_cause, impact, prevention",
            "required": true,
            "type": "custom"
          },
          {
            "check": "No Chinese comments in code",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Data flow tracing included in RCA",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Real scenario verification passed",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-fix",
        "on_pass": "phase-verify"
      },
      "description": "Verify hotfix passes all tests and no regressions",
      "id": "gate-quality",
      "name": "Quality Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/qa-engineer.md",
            "ref": "qa",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "qa",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d6g",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "TEST_CASE.md"
        ],
        "role": "QA"
      },
      "description": "Verify the hotfix and produce test case documentation",
      "docs": [
        {
          "content_rules": [
            "Must contain: reproduction steps, expected result, actual result",
            "Smoke test results required for hotfixes"
          ],
          "description": "Test case document for the hotfix including smoke test results",
          "format": "markdown",
          "name": "TEST_CASE.md",
          "path": "{DOCS_INTERNAL}/{task_id}/TEST_CASE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/bug-test-template.md"
        }
      ],
      "id": "phase-verify",
      "name": "Hotfix Verification",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ],
      "on_exit": [
        {
          "action": "custom",
          "message": "Verify Output Guard 5-step protocol completed",
          "name": "output-guard-check"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "deliverables": [
              "RCA.md",
              "TEST_CASE.md"
            ],
            "type": "deliverables_complete"
          },
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "type": "no_regressions"
          },
          {
            "check": "Output Guard Summary all passed",
            "required": true,
            "type": "custom"
          },
          {
            "check": "User confirmation received",
            "required": true,
            "type": "custom"
          },
          {
            "check": "SCOPE.md generated",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-verify",
        "on_pass": "terminal-success"
      },
      "description": "Final gate verifying all deliverables exist and user confirmation received",
      "id": "gate-completion",
      "name": "Completion Gate",
      "type": "gate"
    },
    {
      "config": {
        "message": "Hotfix flow completed successfully",
        "status": "success"
      },
      "description": "Hotfix completed and verified successfully",
      "id": "terminal-success",
      "name": "Hotfix Applied",
      "on_exit": [
        {
          "action": "custom",
          "message": "Generate handoff document at session end",
          "name": "handoff-doc"
        }
      ],
      "type": "terminal"
    },
    {
      "config": {
        "message": "Hotfix request does not meet emergency criteria",
        "status": "rejected"
      },
      "description": "Hotfix request rejected at entry gate",
      "id": "terminal-reject",
      "name": "Rejected",
      "type": "terminal"
    },
    {
      "config": {
        "message": "Hotfix failed - manual intervention required",
        "status": "failed"
      },
      "description": "Hotfix failed and requires manual escalation",
      "id": "terminal-failed",
      "name": "Escalation Required",
      "type": "terminal"
    }
  ],
  "variables": {
    "DOCS_INTERNAL": "",
    "TEAM_PATH": "",
    "task_id": ""
  },
  "version": "v3"
}
