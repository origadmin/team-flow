{
  "version": "v3",
  "metadata": {
    "name": "analysis-flow",
    "description": "Technical analysis flow: Triage → Analyze → Report → Terminal",
    "author": "team-flow",
    "tags": [
      "analysis",
      "research",
      "software"
    ]
  },
  "config": {
    "task_type": "analysis",
    "auto_dispatch": true,
    "parallel_limit": 2,
    "timeout_minutes": 120
  },
  "variables": {
    "docs_path": "",
    "TEAM_PATH": "",
    "task_id": ""
  },
  "components": {
    "roles": [
      {
        "id": "triage",
        "name": "Triage Agent",
        "description": "Classify and dispatch analysis tasks",
        "capabilities": [
          "classify",
          "dispatch"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/triage.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/triage-standards.md",
        "prompt_directives": [
          "Dispatch tasks to sub-agents, never execute directly",
          "Classify all user input before action: Feature/Bug/Change/Analysis/Batch",
          "Read .team/project.md for project constraints before dispatch",
          "Use flow task create/show for all task state management",
          "Report deliverables and handoff to next role on completion"
        ]
      },
      {
        "id": "analysis",
        "name": "Analyst",
        "description": "Perform analysis and produce reports",
        "capabilities": [
          "analyze",
          "research",
          "report"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/analysis.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/analysis-standards.md"
      },
      {
        "id": "tech-lead",
        "name": "Tech Lead",
        "description": "Review analysis findings",
        "capabilities": [
          "review",
          "architect"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/tech-lead.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/architecture-standards.md",
        "prompt_directives": [
          "Design before implement: SPEC.md + AC.md + Data Model mandatory",
          "Ensure R0 Navigation Matrix covers all entry points",
          "Review all API contracts for consistency",
          "Verify design satisfies all acceptance criteria",
          "Output Guard self-check before marking phase complete"
        ]
      }
    ],
    "rules": [
      {
        "id": "dispatch-guard",
        "name": "Dispatch Guard",
        "description": "Triage must dispatch, never execute directly",
        "source": "builtin",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "output-guard",
        "name": "Output Guard Protocol",
        "description": "5-step self-assessment before completion",
        "source": "framework",
        "type": "process_constraint",
        "enforcement": "hard"
      }
    ],
    "tools": [
      {
        "id": "task",
        "name": "Task CLI",
        "type": "cli",
        "commands": [
          "create",
          "update",
          "show"
        ]
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      }
    ]
  },
  "nodes": [
    {
      "id": "phase-triage",
      "type": "phase",
      "name": "Analysis Triage",
      "description": "Classify and scope the analysis request",
      "config": {
        "role": "Triage",
        "auto_dispatch": true
      },
      "components": {
        "roles": [
          {
            "ref": "triage",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "dispatch-guard",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "triage",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/triage.md"
          }
        ]
      },
      "docs": [
        {
          "name": "TRIAGE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/TRIAGE.md",
          "required": true,
          "description": "Analysis request triage record with scope, objectives, and dispatch decision"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ]
    },
    {
      "id": "phase-analyze",
      "type": "phase",
      "name": "Deep Analysis",
      "description": "Perform technical analysis, investigate codebase, and gather findings",
      "config": {
        "role": "Analysis",
        "auto_dispatch": true,
        "deliverables": [
          "FINDINGS.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "analysis",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "analysis",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/analysis.md"
          }
        ]
      },
      "docs": [
        {
          "name": "FINDINGS.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/FINDINGS.md",
          "required": true,
          "description": "Analysis findings document with detailed investigation results and evidence"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "phase-report",
      "type": "phase",
      "name": "Analysis Report",
      "description": "Compile analysis results into a structured report with conclusions and recommendations",
      "config": {
        "role": "Analysis",
        "auto_dispatch": true,
        "deliverables": [
          "REPORT.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "analysis",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "prompts": [
          {
            "ref": "analysis",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/analysis.md"
          }
        ]
      },
      "docs": [
        {
          "name": "REPORT.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/REPORT.md",
          "required": true,
          "description": "Final analysis report with conclusions, recommendations, and action items"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "review"
        }
      ]
    },
    {
      "id": "terminal-success",
      "type": "terminal",
      "name": "Analysis Complete",
      "description": "Analysis completed and report delivered",
      "config": {
        "status": "success",
        "message": "Analysis flow completed successfully"
      }
    }
  ],
  "edges": [
    {
      "id": "e-triage-analyze",
      "from": "phase-triage",
      "to": "phase-analyze"
    },
    {
      "id": "e-analyze-report",
      "from": "phase-analyze",
      "to": "phase-report"
    },
    {
      "id": "e-report-success",
      "from": "phase-report",
      "to": "terminal-success"
    }
  ]
}