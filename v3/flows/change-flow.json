{
  "version": "v3",
  "metadata": {
    "name": "change-flow",
    "description": "Change management flow: Triage → Gate → Plan → Execute → Gate → Review → Terminal",
    "author": "team-flow",
    "tags": [
      "change",
      "software",
      "refactor"
    ]
  },
  "config": {
    "task_type": "change",
    "auto_dispatch": true,
    "parallel_limit": 3,
    "timeout_minutes": 360
  },
  "variables": {
    "docs_path": "",
    "TEAM_PATH": "",
    "task_id": ""
  },
  "components": {
    "roles": [
      {
        "id": "triage",
        "name": "Triage Agent",
        "description": "Classify and dispatch change requests",
        "capabilities": [
          "classify",
          "dispatch"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/triage.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/triage-standards.md",
        "prompt_directives": [
          "Dispatch tasks to sub-agents, never execute directly",
          "Classify all user input before action: Feature/Bug/Change/Analysis/Batch",
          "Read .team/project.md for project constraints before dispatch",
          "Use flow task create/show for all task state management",
          "Report deliverables and handoff to next role on completion"
        ]
      },
      {
        "id": "tech-lead",
        "name": "Tech Lead",
        "description": "Plan change scope and review impact",
        "capabilities": [
          "plan",
          "review",
          "architect"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/tech-lead.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/architecture-standards.md",
        "prompt_directives": [
          "Design before implement: SPEC.md + AC.md + Data Model mandatory",
          "Ensure R0 Navigation Matrix covers all entry points",
          "Review all API contracts for consistency",
          "Verify design satisfies all acceptance criteria",
          "Output Guard self-check before marking phase complete"
        ]
      },
      {
        "id": "dev",
        "name": "Developer",
        "description": "Execute change implementation",
        "capabilities": [
          "implement",
          "test"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/dev.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/development-standards.md",
        "prompt_directives": [
          "Read SCOPE.md before starting implementation",
          "Surgical changes only: never modify files outside task scope",
          "Run tests before marking phase complete",
          "No Chinese comments or commit messages",
          "Never delete files unless explicitly asked",
          "Output Guard 5-step self-check mandatory before completion gate"
        ]
      },
      {
        "id": "qa",
        "name": "QA Engineer",
        "description": "Verify change completeness",
        "capabilities": [
          "verify",
          "validate"
        ],
        "prompt_source": "{TEAM_PATH}/prompts/qa-engineer.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/test-standards.md",
        "prompt_directives": [
          "Verify implementation matches SPEC.md and AC.md",
          "Run full regression tests, not just new tests",
          "Check front-back interface consistency (paths, params, response)",
          "For bugfixes: data flow trace + real scenario verification required",
          "Output Guard self-check before marking review complete"
        ]
      }
    ],
    "rules": [
      {
        "id": "dispatch-guard",
        "name": "Dispatch Guard",
        "description": "Triage must dispatch, never execute directly",
        "source": "builtin",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "output-guard",
        "name": "Output Guard Protocol",
        "description": "5-step self-assessment before completion",
        "source": "framework",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "regression-guard",
        "name": "Regression Prevention",
        "description": "Prevent regressions during change",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "hard-constraints",
        "name": "Hard Constraints",
        "description": "No file deletion, no PowerShell Set-Content/Out-File, no skip toolchain gate",
        "source": "builtin",
        "type": "behavioral_constraint",
        "enforcement": "hard"
      },
      {
        "id": "development-standards",
        "name": "Development Standards",
        "description": "No Chinese comments/commits, TDD, no BOM-polluting tools",
        "source": "builtin",
        "type": "behavioral_constraint",
        "enforcement": "hard"
      },
      {
        "id": "architecture-standards",
        "name": "Architecture Standards",
        "description": "Design artifacts must follow R1-R3 format",
        "source": "builtin",
        "type": "output_constraint",
        "enforcement": "hard"
      },
      {
        "id": "review-standards",
        "name": "Review Standards",
        "description": "Architecture compliance, SCOPE.md generation",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "qg1-think-before-coding",
        "name": "QG-1: Think Before Coding",
        "description": "Before any action, verify assumptions: what assumptions am I acting on? What's the worst case if wrong? What should I clarify first?",
        "enforcement": "hard",
        "trigger": "pre_action"
      },
      {
        "id": "qg2-simplicity-first",
        "name": "QG-2: Simplicity First",
        "description": "Can this be solved with less code? Am I adding unrequested features? Is this over-engineered?",
        "enforcement": "hard",
        "trigger": "pre_output"
      },
      {
        "id": "qg3-surgical-changes",
        "name": "QG-3: Surgical Changes",
        "description": "Only modify code within task scope. Never optimize or refactor adjacent code. Clean up orphan code from own changes.",
        "enforcement": "hard",
        "trigger": "code_change"
      },
      {
        "id": "qg4-goal-driven",
        "name": "QG-4: Goal-Driven Execution",
        "description": "Define success criteria before executing. Each step must have concrete verification criteria. Never use vague 'completed' descriptions.",
        "enforcement": "hard",
        "trigger": "task_start"
      }
    ],
    "tools": [
      {
        "id": "task",
        "name": "Task CLI",
        "type": "cli",
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list"
        ]
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ]
  },
  "nodes": [
    {
      "id": "phase-triage",
      "type": "phase",
      "name": "Change Triage",
      "description": "Classify and validate the change request",
      "config": {
        "role": "Triage",
        "auto_dispatch": true
      },
      "components": {
        "roles": [
          {
            "ref": "triage",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "dispatch-guard",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "triage",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/triage.md"
          }
        ]
      },
      "docs": [
        {
          "name": "TRIAGE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/TRIAGE.md",
          "required": true,
          "description": "Change request triage record with classification, priority, and dispatch decision"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ]
    },
    {
      "id": "gate-entry",
      "type": "gate",
      "name": "Entry Gate",
      "description": "Validate change request has sufficient context and type matches",
      "config": {
        "conditions": [
          {
            "type": "task_exists"
          },
          {
            "type": "type_matches",
            "expected": "change"
          }
        ],
        "on_pass": "phase-plan",
        "on_fail": "terminal-reject"
      }
    },
    {
      "id": "phase-plan",
      "type": "phase",
      "name": "Change Planning",
      "description": "Plan the change scope, impact analysis, and migration strategy",
      "config": {
        "role": "TechLead",
        "auto_dispatch": true,
        "deliverables": [
          "SCOPE.md",
          "IMPACT.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "architecture-standards",
            "source": "builtin"
          },
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ]
      },
      "docs": [
        {
          "name": "SCOPE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/SCOPE.md",
          "required": true,
          "description": "Change scope document detailing what will be modified, added, or removed",
          "content_rules": [
            "Must contain: changed files, added files, deleted files, risk assessment"
          ],
          "template": "{TEAM_PATH}/templates/scope-template.md"
        },
        {
          "name": "IMPACT.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/IMPACT.md",
          "required": true,
          "description": "Impact analysis document identifying affected components, dependencies, and migration steps"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "phase-execute",
      "type": "phase",
      "name": "Change Execution",
      "description": "Execute the planned changes and update tests",
      "config": {
        "role": "Dev",
        "auto_dispatch": true,
        "deliverables": [
          "code",
          "updated_tests"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "development-standards",
            "source": "builtin"
          },
          {
            "ref": "regression-guard",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-ops"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "EXEC.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/EXEC.md",
          "required": true,
          "description": "Change execution notes documenting modifications made, files affected, and test updates"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "gate-quality",
      "type": "gate",
      "name": "Quality Gate",
      "description": "Verify changes pass all tests and no regressions introduced",
      "config": {
        "conditions": [
          {
            "type": "tests_pass",
            "threshold": "100%"
          },
          {
            "type": "lint_pass",
            "threshold": "0 errors"
          },
          {
            "type": "no_regressions"
          }
        ],
        "on_pass": "phase-review",
        "on_fail": "phase-execute",
        "auto_retry": {
          "max_attempts": 2,
          "delay_minutes": 5
        }
      }
    },
    {
      "id": "phase-review",
      "type": "phase",
      "name": "Change Review",
      "description": "Review the change for correctness, completeness, and produce final SCOPE.md",
      "config": {
        "role": "TechLead",
        "auto_dispatch": true,
        "deliverables": [
          "SCOPE.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "review-standards",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ]
      },
      "docs": [
        {
          "name": "SCOPE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/SCOPE.md",
          "required": true,
          "description": "Final scope document summarizing completed changes, affected areas, and verification notes",
          "content_rules": [
            "Must contain: changed files, added files, deleted files, risk assessment"
          ],
          "template": "{TEAM_PATH}/templates/scope-template.md"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "review"
        }
      ]
    },
    {
      "id": "terminal-success",
      "type": "terminal",
      "name": "Change Completed",
      "description": "Change implemented and reviewed successfully",
      "config": {
        "status": "success",
        "message": "Change flow completed successfully"
      }
    },
    {
      "id": "terminal-reject",
      "type": "terminal",
      "name": "Rejected",
      "description": "Change request rejected at entry gate",
      "config": {
        "status": "rejected",
        "message": "Change request does not meet requirements"
      }
    }
  ],
  "edges": [
    {
      "id": "e-triage-gate",
      "from": "phase-triage",
      "to": "gate-entry"
    },
    {
      "id": "e-gate-plan",
      "from": "gate-entry",
      "to": "phase-plan",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-gate-reject",
      "from": "gate-entry",
      "to": "terminal-reject",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    },
    {
      "id": "e-plan-execute",
      "from": "phase-plan",
      "to": "phase-execute"
    },
    {
      "id": "e-execute-gate",
      "from": "phase-execute",
      "to": "gate-quality"
    },
    {
      "id": "e-gate-review",
      "from": "gate-quality",
      "to": "phase-review",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-gate-execute",
      "from": "gate-quality",
      "to": "phase-execute",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    },
    {
      "id": "e-review-success",
      "from": "phase-review",
      "to": "terminal-success"
    }
  ]
}