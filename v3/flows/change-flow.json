{
  "components": {
    "roles": [],
    "rules": [],
    "skills": [],
    "tools": [
      {
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ],
        "id": "task",
        "name": "Task CLI",
        "type": "cli"
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ]
  },
  "config": {
    "auto_dispatch": true,
    "parallel_limit": 2,
    "task_type": "change",
    "timeout_minutes": 360
  },
  "edges": [
    {
      "from": "phase-triage",
      "id": "e-triage-gate",
      "to": "gate-entry"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-plan",
      "to": "phase-plan",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-reject",
      "to": "terminal-reject",
      "type": "conditional"
    },
    {
      "from": "phase-plan",
      "id": "e-plan-execute",
      "to": "phase-execute"
    },
    {
      "from": "phase-execute",
      "id": "e-execute-gate",
      "to": "gate-quality"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-quality",
      "id": "e-gate-verify",
      "to": "phase-verify",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-quality",
      "id": "e-gate-execute-retry",
      "to": "phase-execute",
      "type": "conditional"
    },
    {
      "from": "phase-verify",
      "id": "e-verify-completion",
      "to": "gate-completion"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-success",
      "to": "terminal-success",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-verify",
      "to": "phase-verify",
      "type": "conditional"
    }
  ],
  "metadata": {
    "author": "team-flow",
    "description": "Change flow: Triage → Gate → Plan → Execute → Quality Gate → Verify → Completion Gate → Terminal",
    "name": "change-flow",
    "tags": [
      "change",
      "refactor",
      "software"
    ]
  },
  "nodes": [
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/triage.md",
            "ref": "triage",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "triage",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d1a",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "role": "Triage"
      },
      "description": "Classify and validate the change request",
      "docs": [
        {
          "description": "Change triage record with change type, scope assessment, and dispatch decision",
          "format": "markdown",
          "name": "TRIAGE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/TRIAGE.md",
          "required": true
        }
      ],
      "id": "phase-triage",
      "name": "Change Triage",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "type": "task_exists"
          },
          {
            "expected": "change",
            "type": "type_matches"
          }
        ],
        "on_fail": "terminal-reject",
        "on_pass": "phase-plan"
      },
      "description": "Validate change request has sufficient context",
      "id": "gate-entry",
      "name": "Entry Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/tech-lead.md",
            "ref": "tech-lead",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "tech-lead",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d9k",
            "source": "builtin"
          },
          {
            "ref": "d2b",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "commands": [
              "show",
              "update",
              "append"
            ],
            "ref": "task"
          },
          {
            "ref": "search"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "SCOPE.md",
          "IMPACT.md"
        ],
        "role": "TechLead"
      },
      "description": "Plan the change scope, impact analysis, and migration strategy",
      "docs": [
        {
          "content_rules": [
            "Must contain: changed files, added files, deleted files, risk assessment"
          ],
          "description": "Change scope: what will be modified, added, or removed, with dependency map",
          "format": "markdown",
          "name": "SCOPE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/SCOPE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/scope-template.md"
        },
        {
          "description": "Impact analysis: affected components, dependencies, migration steps, rollback plan",
          "format": "markdown",
          "name": "IMPACT.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/IMPACT.md",
          "required": true
        }
      ],
      "id": "phase-plan",
      "name": "Change Planning",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ],
      "type": "phase"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/dev.md",
            "ref": "dev",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "dev",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d5f",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          },
          {
            "ref": "d4e",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-ops"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "code",
          "updated_tests"
        ],
        "role": "Dev"
      },
      "description": "Execute the planned changes and update tests",
      "docs": [
        {
          "description": "Change execution notes: modifications made, files affected, test updates",
          "format": "markdown",
          "name": "EXEC.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/EXEC.md",
          "required": true
        }
      ],
      "id": "phase-execute",
      "name": "Change Execution",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "auto_retry": {
          "delay_minutes": 5,
          "max_attempts": 2
        },
        "conditions": [
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "threshold": "0 errors",
            "type": "lint_pass"
          },
          {
            "type": "no_regressions"
          },
          {
            "check": "No Chinese comments in code",
            "required": true,
            "type": "custom"
          },
          {
            "check": "SCOPE.md and IMPACT.md exist and non-empty",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-execute",
        "on_pass": "phase-verify"
      },
      "description": "Verify changes pass all tests and no regressions",
      "id": "gate-quality",
      "name": "Quality Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/qa-engineer.md",
            "ref": "qa",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "qa",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d6g",
            "source": "builtin"
          },
          {
            "ref": "d7h",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "TEST_COVERAGE.md"
        ],
        "role": "QA"
      },
      "description": "Verify the changes and produce test coverage report",
      "docs": [
        {
          "description": "Test coverage report for the change including regression test results",
          "format": "markdown",
          "name": "TEST_COVERAGE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/TEST_COVERAGE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/feature-test-template.md"
        }
      ],
      "id": "phase-verify",
      "name": "Change Verification",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ],
      "on_exit": [
        {
          "action": "custom",
          "message": "Verify Output Guard 5-step protocol completed",
          "name": "output-guard-check"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "deliverables": [
              "SCOPE.md",
              "IMPACT.md",
              "EXEC.md",
              "TEST_COVERAGE.md"
            ],
            "type": "deliverables_complete"
          },
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "type": "no_regressions"
          },
          {
            "check": "Output Guard Summary all passed",
            "required": true,
            "type": "custom"
          },
          {
            "check": "User confirmation received",
            "required": true,
            "type": "custom"
          },
          {
            "check": "SCOPE.md generated",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-verify",
        "on_pass": "terminal-success"
      },
      "description": "Final gate verifying all deliverables exist and user confirmation received",
      "id": "gate-completion",
      "name": "Completion Gate",
      "type": "gate"
    },
    {
      "config": {
        "message": "Change flow completed successfully",
        "status": "success"
      },
      "description": "Change completed and verified successfully",
      "id": "terminal-success",
      "name": "Changed",
      "on_exit": [
        {
          "action": "custom",
          "message": "Generate handoff document at session end",
          "name": "handoff-doc"
        }
      ],
      "type": "terminal"
    },
    {
      "config": {
        "message": "Change request does not meet requirements",
        "status": "rejected"
      },
      "description": "Change request rejected at entry gate",
      "id": "terminal-reject",
      "name": "Rejected",
      "type": "terminal"
    }
  ],
  "variables": {
    "DOCS_INTERNAL": "",
    "TEAM_PATH": "",
    "task_id": ""
  },
  "version": "v3"
}
