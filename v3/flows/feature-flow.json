{
  "version": "v3",
  "metadata": {
    "name": "feature-flow",
    "description": "Standard feature development flow: Triage → Gate → Analyze → Design → Implement → Gate → Verify → Review → Terminal",
    "author": "team-flow",
    "tags": [
      "feature",
      "default",
      "software"
    ]
  },
  "config": {
    "task_type": "feature",
    "auto_dispatch": true,
    "parallel_limit": 3,
    "timeout_minutes": 480
  },
  "variables": {
    "docs_path": "",
    "TEAM_PATH": "",
    "task_id": ""
  },
  "components": {
    "roles": [
      {
        "id": "triage",
        "name": "Triage Agent",
        "description": "Classify and dispatch incoming tasks to appropriate flows",
        "prompt_source": "{TEAM_PATH}/prompts/triage.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/triage-standards.md",
        "capabilities": [
          "classify",
          "dispatch",
          "assess"
        ],
        "prompt_directives": [
          "Dispatch tasks to sub-agents, never execute directly",
          "Classify all user input before action: Feature/Bug/Change/Analysis/Batch",
          "Read .team/project.md for project constraints before dispatch",
          "Use flow task create/show for all task state management",
          "Report deliverables and handoff to next role on completion"
        ]
      },
      {
        "id": "tech-lead",
        "name": "Tech Lead",
        "description": "Analyze requirements, design architecture, review code",
        "prompt_source": "{TEAM_PATH}/prompts/tech-lead.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/architecture-standards.md",
        "capabilities": [
          "analyze",
          "design",
          "review",
          "architect"
        ],
        "prompt_directives": [
          "Design before implement: SPEC.md + AC.md + Data Model mandatory",
          "Ensure R0 Navigation Matrix covers all entry points",
          "Review all API contracts for consistency",
          "Verify design satisfies all acceptance criteria",
          "Output Guard self-check before marking phase complete"
        ]
      },
      {
        "id": "dev",
        "name": "Developer",
        "description": "Implement features, write code and unit tests",
        "prompt_source": "{TEAM_PATH}/prompts/dev.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/development-standards.md",
        "capabilities": [
          "implement",
          "test",
          "debug"
        ],
        "prompt_directives": [
          "Read SCOPE.md before starting implementation",
          "Surgical changes only: never modify files outside task scope",
          "Run tests before marking phase complete",
          "No Chinese comments or commit messages",
          "Never delete files unless explicitly asked",
          "Output Guard 5-step self-check mandatory before completion gate"
        ]
      },
      {
        "id": "qa",
        "name": "QA Engineer",
        "description": "Verify implementations, run integration and E2E tests",
        "prompt_source": "{TEAM_PATH}/prompts/qa-engineer.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/test-standards.md",
        "capabilities": [
          "verify",
          "test",
          "validate"
        ],
        "prompt_directives": [
          "Verify implementation matches SPEC.md and AC.md",
          "Run full regression tests, not just new tests",
          "Check front-back interface consistency (paths, params, response)",
          "For bugfixes: data flow trace + real scenario verification required",
          "Output Guard self-check before marking review complete"
        ]
      }
    ],
    "rules": [
      {
        "id": "dispatch-guard",
        "name": "Dispatch Guard",
        "description": "Triage must dispatch tasks to sub-agents, never execute directly",
        "source": "builtin",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "output-guard",
        "name": "Output Guard Protocol",
        "description": "5-step self-assessment before completion gate: AC compliance matrix, compile check, test execution, self-critique, output summary",
        "source": "framework",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "regression-guard",
        "name": "Regression Prevention",
        "description": "Prevent regressions in existing functionality during implementation",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "requirements-standards",
        "name": "Requirements Standards",
        "description": "SPEC must include scope, constraints, and measurable acceptance criteria",
        "source": "builtin",
        "type": "output_constraint",
        "enforcement": "hard"
      },
      {
        "id": "architecture-standards",
        "name": "Architecture Standards",
        "description": "Design artifacts must follow R1-R3 format: data model, state machine, API contract",
        "source": "builtin",
        "type": "output_constraint",
        "enforcement": "hard"
      },
      {
        "id": "development-standards",
        "name": "Development Standards",
        "description": "No Chinese comments, no Chinese commit messages, TDD approach, no PowerShell Set-Content/Out-File",
        "source": "builtin",
        "type": "behavioral_constraint",
        "enforcement": "hard"
      },
      {
        "id": "test-standards",
        "name": "Test Standards",
        "description": "Unit tests must pass, integration tests must cover API contracts, coverage report required",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "hard-constraints",
        "name": "Hard Constraints",
        "description": "Never delete files (use trash), never use PowerShell Set-Content/Out-File (BOM pollution), never skip toolchain gate",
        "source": "builtin",
        "type": "behavioral_constraint",
        "enforcement": "hard"
      },
      {
        "id": "review-standards",
        "name": "Review Standards",
        "description": "Code review must check architecture compliance, generate SCOPE.md with change summary",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      }
    ],
    "tools": [
      {
        "id": "task",
        "name": "Task CLI",
        "type": "cli",
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ]
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ],
    "skills": [
      {
        "id": "api-design",
        "name": "API Design",
        "source": "builtin",
        "trigger": "manual",
        "path": "{TEAM_PATH}/skills/api-design/SKILL.md",
        "description": "Design RESTful/gRPC API contracts with consistent naming and error handling"
      },
      {
        "id": "protobuf",
        "name": "Protobuf",
        "source": "builtin",
        "trigger": "manual",
        "path": "{TEAM_PATH}/skills/protobuf/SKILL.md",
        "description": "Protocol Buffer schema design and code generation"
      }
    ]
  },
  "nodes": [
    {
      "id": "phase-triage",
      "type": "phase",
      "name": "Task Triage",
      "description": "Classify and dispatch the incoming task to the appropriate flow",
      "config": {
        "role": "Triage",
        "auto_dispatch": true
      },
      "components": {
        "roles": [
          {
            "ref": "triage",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "dispatch-guard",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "triage",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/triage.md"
          }
        ]
      },
      "docs": [
        {
          "name": "TRIAGE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/TRIAGE.md",
          "required": true,
          "description": "Triage classification record with task type, priority, and dispatch decision"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ]
    },
    {
      "id": "gate-entry",
      "type": "gate",
      "name": "Entry Gate",
      "description": "Validate task exists and type matches feature",
      "config": {
        "conditions": [
          {
            "type": "task_exists"
          },
          {
            "type": "type_matches",
            "expected": "feature"
          }
        ],
        "on_pass": "phase-analyze",
        "on_fail": "terminal-reject"
      }
    },
    {
      "id": "phase-analyze",
      "type": "phase",
      "name": "Requirements Analysis",
      "description": "Analyze requirements and produce SPEC and acceptance criteria",
      "config": {
        "role": "TechLead",
        "auto_dispatch": true,
        "deliverables": [
          "SPEC.md",
          "AC.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "requirements-standards",
            "source": "builtin"
          },
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "skills": [
          {
            "ref": "api-design"
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ]
      },
      "docs": [
        {
          "name": "SPEC.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/SPEC.md",
          "required": true,
          "description": "Feature specification document detailing requirements, scope, and constraints",
          "content_rules": [
            "Must contain: overview, requirements, constraints, dependencies"
          ]
        },
        {
          "name": "AC.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/AC.md",
          "required": true,
          "description": "Acceptance criteria with measurable conditions for feature completion",
          "content_rules": [
            "Must contain: acceptance criteria as testable assertions",
            "Each criterion must be verifiable (pass/fail)"
          ]
        }
      ],
      "gates": [
        {
          "type": "deliverable_check",
          "required": [
            "SPEC.md",
            "AC.md"
          ],
          "on_fail": "phase-analyze"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "phase-design",
      "type": "phase",
      "name": "Technical Design",
      "description": "Design data models, state machines, and API contracts",
      "config": {
        "role": "TechLead",
        "auto_dispatch": true,
        "deliverables": [
          "R1_DATA_MODEL.md",
          "R2_STATE_MACHINE.md",
          "R3_API_CONTRACT.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "architecture-standards",
            "source": "builtin"
          }
        ],
        "skills": [
          {
            "ref": "protobuf"
          },
          {
            "ref": "api-design"
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ]
      },
      "docs": [
        {
          "name": "R1_DATA_MODEL.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/R1_DATA_MODEL.md",
          "required": true,
          "description": "Data model design including entity relationships and schema definitions"
        },
        {
          "name": "R2_STATE_MACHINE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/R2_STATE_MACHINE.md",
          "required": true,
          "description": "State machine design defining transitions, events, and lifecycle"
        },
        {
          "name": "R3_API_CONTRACT.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/R3_API_CONTRACT.md",
          "required": true,
          "description": "API contract definitions including endpoints, request/response schemas"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "design"
        }
      ]
    },
    {
      "id": "phase-implement",
      "type": "phase",
      "name": "Implementation",
      "description": "Implement the feature code and unit tests",
      "config": {
        "role": "Dev",
        "auto_dispatch": true,
        "deliverables": [
          "code",
          "unit_tests"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "development-standards",
            "source": "builtin"
          },
          {
            "ref": "regression-guard",
            "source": "builtin"
          },
          {
            "ref": "hard-constraints",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-ops"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "IMPL.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/IMPL.md",
          "required": true,
          "description": "Implementation notes documenting key code changes, architectural decisions, and test coverage"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "gate-quality",
      "type": "gate",
      "name": "Quality Gate",
      "description": "Verify tests pass, lint is clean, and no regressions exist",
      "config": {
        "conditions": [
          {
            "type": "tests_pass",
            "threshold": "100%"
          },
          {
            "type": "lint_pass",
            "threshold": "0 errors"
          },
          {
            "type": "no_regressions"
          }
        ],
        "on_pass": "phase-verify",
        "on_fail": "phase-implement",
        "auto_retry": {
          "max_attempts": 2,
          "delay_minutes": 5
        }
      }
    },
    {
      "id": "phase-verify",
      "type": "phase",
      "name": "Integration Verification",
      "description": "Run full integration and E2E tests, verify feature completeness",
      "config": {
        "role": "QA",
        "auto_dispatch": true,
        "deliverables": [
          "TEST_COVERAGE.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "qa",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "test-standards",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "qa",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/qa-engineer.md"
          }
        ]
      },
      "docs": [
        {
          "name": "TEST_COVERAGE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/TEST_COVERAGE.md",
          "required": true,
          "description": "Test coverage report including unit, integration, and E2E test results"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ]
    },
    {
      "id": "phase-review",
      "type": "phase",
      "name": "Code Review",
      "description": "Review code quality, architecture compliance, and produce SCOPE.md",
      "config": {
        "role": "TechLead",
        "auto_dispatch": true,
        "deliverables": [
          "SCOPE.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "review-standards",
            "source": "builtin"
          },
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ]
      },
      "docs": [
        {
          "name": "SCOPE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/SCOPE.md",
          "required": true,
          "description": "Completion scope document summarizing what was implemented, changed, and any known issues",
          "content_rules": [
            "Must contain: changed files, added files, deleted files, risk assessment"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "review"
        }
      ],
      "on_exit": [
        {
          "action": "custom",
          "name": "output-guard-check",
          "message": "Verify Output Guard 5-step protocol completed"
        }
      ]
    },
    {
      "id": "gate-completion",
      "type": "gate",
      "name": "Completion Gate",
      "description": "Final gate verifying all deliverables exist, Output Guard passed, and user confirmation received before closing",
      "config": {
        "conditions": [
          {
            "type": "deliverables_complete",
            "deliverables": [
              "SPEC.md",
              "AC.md",
              "R1_DATA_MODEL.md",
              "R2_STATE_MACHINE.md",
              "R3_API_CONTRACT.md",
              "IMPL.md",
              "TEST_COVERAGE.md",
              "SCOPE.md"
            ]
          },
          {
            "type": "tests_pass",
            "threshold": "100%"
          },
          {
            "type": "lint_pass",
            "threshold": "0 errors"
          },
          {
            "type": "no_regressions"
          },
          {
            "type": "custom",
            "check": "Output Guard Summary all passed",
            "required": true
          },
          {
            "type": "custom",
            "check": "User confirmation received",
            "required": true
          }
        ],
        "on_pass": "terminal-success",
        "on_fail": "phase-review"
      }
    },
    {
      "id": "terminal-success",
      "type": "terminal",
      "name": "Completed",
      "description": "Feature development completed successfully",
      "config": {
        "status": "success",
        "message": "Feature development flow completed successfully"
      },
      "on_exit": [
        {
          "action": "custom",
          "name": "handoff-doc",
          "message": "Generate handoff document at session end"
        }
      ]
    },
    {
      "id": "terminal-reject",
      "type": "terminal",
      "name": "Rejected",
      "description": "Task rejected at entry gate",
      "config": {
        "status": "rejected",
        "message": "Task does not match feature type requirements"
      }
    }
  ],
  "edges": [
    {
      "id": "e-triage-gate",
      "from": "phase-triage",
      "to": "gate-entry"
    },
    {
      "id": "e-gate-analyze",
      "from": "gate-entry",
      "to": "phase-analyze",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-gate-reject",
      "from": "gate-entry",
      "to": "terminal-reject",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    },
    {
      "id": "e-analyze-design",
      "from": "phase-analyze",
      "to": "phase-design"
    },
    {
      "id": "e-design-implement",
      "from": "phase-design",
      "to": "phase-implement"
    },
    {
      "id": "e-implement-gate",
      "from": "phase-implement",
      "to": "gate-quality"
    },
    {
      "id": "e-gate-verify",
      "from": "gate-quality",
      "to": "phase-verify",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-gate-implement",
      "from": "gate-quality",
      "to": "phase-implement",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    },
    {
      "id": "e-verify-review",
      "from": "phase-verify",
      "to": "phase-review"
    },
    {
      "id": "e-review-completion",
      "from": "phase-review",
      "to": "gate-completion"
    },
    {
      "id": "e-completion-success",
      "from": "gate-completion",
      "to": "terminal-success",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-completion-review",
      "from": "gate-completion",
      "to": "phase-review",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    }
  ]
}