{
  "version": "v3",
  "metadata": {
    "name": "bugfix-flow",
    "description": "Bug fix flow with R-iteration: Triage → Gate → Investigate → Fix(R0..Rn) → Quality Gate → Verify → Completion Gate → Terminal",
    "author": "team-flow",
    "tags": [
      "bug",
      "bugfix",
      "software"
    ]
  },
  "config": {
    "task_type": "bug",
    "auto_dispatch": true,
    "parallel_limit": 2,
    "timeout_minutes": 240
  },
  "variables": {
    "docs_path": "",
    "TEAM_PATH": "",
    "task_id": "",
    "iteration": "R0"
  },
  "components": {
    "roles": [
      {
        "id": "triage",
        "name": "Triage Agent",
        "description": "Classify and dispatch bug reports",
        "prompt_source": "{TEAM_PATH}/prompts/triage.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/triage-standards.md",
        "capabilities": [
          "classify",
          "dispatch",
          "assess"
        ],
        "prompt_directives": [
          "Dispatch tasks to sub-agents, never execute directly",
          "Classify all user input before action: Feature/Bug/Change/Analysis/Batch",
          "Read .team/project.md for project constraints before dispatch",
          "Use flow task create/show for all task state management",
          "Report deliverables and handoff to next role on completion"
        ]
      },
      {
        "id": "dev",
        "name": "Developer",
        "description": "Investigate root cause, implement bug fix, add regression tests",
        "prompt_source": "{TEAM_PATH}/prompts/dev.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/bugfix-standards.md",
        "capabilities": [
          "investigate",
          "implement",
          "test",
          "debug"
        ],
        "prompt_directives": [
          "Read SCOPE.md before starting implementation",
          "Surgical changes only: never modify files outside task scope",
          "Run tests before marking phase complete",
          "No Chinese comments or commit messages",
          "Never delete files unless explicitly asked",
          "Output Guard 5-step self-check mandatory before completion gate"
        ]
      },
      {
        "id": "qa",
        "name": "QA Engineer",
        "description": "Verify bug fix, run regression tests, validate completeness",
        "prompt_source": "{TEAM_PATH}/prompts/qa-engineer.md",
        "standards_source": "{TEAM_PATH}/workflows/roles/test-standards.md",
        "capabilities": [
          "verify",
          "test",
          "validate"
        ],
        "prompt_directives": [
          "Verify implementation matches SPEC.md and AC.md",
          "Run full regression tests, not just new tests",
          "Check front-back interface consistency (paths, params, response)",
          "For bugfixes: data flow trace + real scenario verification required",
          "Output Guard self-check before marking review complete"
        ]
      }
    ],
    "rules": [
      {
        "id": "dispatch-guard",
        "name": "Dispatch Guard",
        "description": "Triage must dispatch tasks to sub-agents, never execute directly",
        "source": "builtin",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "output-guard",
        "name": "Output Guard Protocol",
        "description": "5-step self-assessment before completion gate: AC compliance matrix, compile check, test execution, self-critique, output summary",
        "source": "framework",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "regression-guard",
        "name": "Regression Prevention",
        "description": "Every bug fix must include regression tests; no fix without test",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "r-iteration-rule",
        "name": "R-Iteration Isolation",
        "description": "Each fix iteration stores docs in R{N} subdirectory; max 3 iterations before escalation",
        "source": "builtin",
        "type": "process_constraint",
        "enforcement": "hard"
      },
      {
        "id": "development-standards",
        "name": "Development Standards",
        "description": "No Chinese comments, no Chinese commit messages, TDD approach, no PowerShell Set-Content/Out-File",
        "source": "builtin",
        "type": "behavioral_constraint",
        "enforcement": "hard"
      },
      {
        "id": "test-standards",
        "name": "Test Standards",
        "description": "Unit tests must pass, regression tests must cover the fixed behavior, coverage report required",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "review-standards",
        "name": "Review Standards",
        "description": "Code review must verify fix correctness, check for side effects, generate SCOPE.md",
        "source": "builtin",
        "type": "quality_constraint",
        "enforcement": "hard"
      },
      {
        "id": "hard-constraints",
        "name": "Hard Constraints",
        "description": "Never delete files (use trash), never use PowerShell Set-Content/Out-File (BOM pollution), never skip toolchain gate",
        "source": "builtin",
        "type": "behavioral_constraint",
        "enforcement": "hard"
      },
      {
        "id": "qg1-think-before-coding",
        "name": "QG-1: Think Before Coding",
        "description": "Before any action, verify assumptions: what assumptions am I acting on? What's the worst case if wrong? What should I clarify first?",
        "enforcement": "hard",
        "trigger": "pre_action"
      },
      {
        "id": "qg2-simplicity-first",
        "name": "QG-2: Simplicity First",
        "description": "Can this be solved with less code? Am I adding unrequested features? Is this over-engineered?",
        "enforcement": "hard",
        "trigger": "pre_output"
      },
      {
        "id": "qg3-surgical-changes",
        "name": "QG-3: Surgical Changes",
        "description": "Only modify code within task scope. Never optimize or refactor adjacent code. Clean up orphan code from own changes.",
        "enforcement": "hard",
        "trigger": "code_change"
      },
      {
        "id": "qg4-goal-driven",
        "name": "QG-4: Goal-Driven Execution",
        "description": "Define success criteria before executing. Each step must have concrete verification criteria. Never use vague 'completed' descriptions.",
        "enforcement": "hard",
        "trigger": "task_start"
      }
    ],
    "tools": [
      {
        "id": "task",
        "name": "Task CLI",
        "type": "cli",
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ]
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ],
    "skills": []
  },
  "nodes": [
    {
      "id": "phase-triage",
      "type": "phase",
      "name": "Bug Triage",
      "description": "Classify and validate the bug report",
      "config": {
        "role": "Triage",
        "auto_dispatch": true
      },
      "components": {
        "roles": [
          {
            "ref": "triage",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "dispatch-guard",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "triage",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/triage.md"
          }
        ]
      },
      "docs": [
        {
          "name": "TRIAGE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/TRIAGE.md",
          "required": true,
          "description": "Bug triage record with severity assessment, priority, and dispatch decision"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ]
    },
    {
      "id": "gate-entry",
      "type": "gate",
      "name": "Entry Gate",
      "description": "Validate bug report has sufficient information and type matches",
      "config": {
        "conditions": [
          {
            "type": "task_exists"
          },
          {
            "type": "type_matches",
            "expected": "bug"
          }
        ],
        "on_pass": "phase-investigate",
        "on_fail": "terminal-reject"
      }
    },
    {
      "id": "phase-investigate",
      "type": "phase",
      "name": "Root Cause Investigation",
      "description": "Investigate the bug, identify root cause, and produce RCA document",
      "config": {
        "role": "Dev",
        "auto_dispatch": true,
        "deliverables": [
          "RCA.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "development-standards",
            "source": "builtin"
          },
          {
            "ref": "output-guard",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "RCA.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/R0/RCA.md",
          "required": true,
          "description": "Root cause analysis document detailing bug origin, affected components, and reproduction steps",
          "content_rules": [
            "Must contain: phenomenon, root_cause, impact, prevention",
            "Data flow trace required for API/permission/state bugs",
            "Real scenario verification required (not mock-only)"
          ],
          "template": "{TEAM_PATH}/templates/bug-test-template.md"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "phase-fix",
      "type": "phase",
      "name": "Bug Fix",
      "description": "Implement the bug fix and add regression tests (R-iteration, docs stored in R{N} subdirectory)",
      "config": {
        "role": "Dev",
        "auto_dispatch": true,
        "deliverables": [
          "code",
          "regression_tests"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "development-standards",
            "source": "builtin"
          },
          {
            "ref": "regression-guard",
            "source": "builtin"
          },
          {
            "ref": "r-iteration-rule",
            "source": "builtin"
          },
          {
            "ref": "hard-constraints",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-ops"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "FIX.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/{iteration}/FIX.md",
          "required": true,
          "description": "Bug fix implementation notes: fix approach, code changes, regression test additions"
        },
        {
          "name": "SCOPE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/{iteration}/SCOPE.md",
          "required": true,
          "description": "Change scope document: what was fixed, what changed, known side effects",
          "content_rules": [
            "Must contain: changed files, added files, deleted files, risk assessment"
          ],
          "template": "{TEAM_PATH}/templates/scope-template.md"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        },
        {
          "action": "set_variable",
          "name": "iteration",
          "value": "{iteration}"
        }
      ]
    },
    {
      "id": "gate-quality",
      "type": "gate",
      "name": "Quality Gate",
      "description": "Verify fix passes all tests, no regressions introduced, and regression tests exist",
      "config": {
        "conditions": [
          {
            "type": "tests_pass",
            "threshold": "100%"
          },
          {
            "type": "lint_pass",
            "threshold": "0 errors"
          },
          {
            "type": "no_regressions"
          },
          {
            "type": "custom",
            "check": "Regression tests added for the fix",
            "required": true
          },
          {
            "type": "custom",
            "required": true,
            "check": "RCA.md contains: phenomenon, root_cause, impact, prevention"
          },
          {
            "type": "custom",
            "required": true,
            "check": "TEST_CASE.md contains: reproduce steps, expected result, verification result"
          },
          {
            "type": "custom",
            "required": true,
            "check": "Bug reproduce test passed (show test output)"
          },
          {
            "type": "custom",
            "required": true,
            "check": "No Chinese comments in code"
          },
          {
            "type": "custom",
            "required": true,
            "check": "Data flow tracing included in RCA (for API/auth/state/interaction bugs)"
          },
          {
            "type": "custom",
            "required": true,
            "check": "Real scenario verification passed (not just mock tests)"
          },
          {
            "type": "custom",
            "required": true,
            "check": "Full chain verified (not just breakpoint fix)"
          }
        ],
        "on_pass": "branch-r-iteration",
        "on_fail": "phase-fix",
        "auto_retry": {
          "max_attempts": 3,
          "delay_minutes": 5
        }
      }
    },
    {
      "id": "branch-r-iteration",
      "type": "branch",
      "name": "R-Iteration Decision",
      "description": "Check if QA verification passed or needs another fix iteration",
      "config": {
        "conditions": [
          {
            "when": "iteration_count < 3 && qa_result == 'failed'",
            "goto": "phase-fix",
            "target": "phase-fix"
          },
          {
            "when": "iteration_count >= 3 && qa_result == 'failed'",
            "goto": "terminal-failed",
            "target": "terminal-failed"
          },
          {
            "default": "phase-verify",
            "target": "phase-verify"
          }
        ]
      }
    },
    {
      "id": "phase-verify",
      "type": "phase",
      "name": "Fix Verification",
      "description": "Verify the bug is fixed and produce test case documentation",
      "config": {
        "role": "QA",
        "auto_dispatch": true,
        "deliverables": [
          "TEST_CASE.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "qa",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "test-standards",
            "source": "builtin"
          },
          {
            "ref": "regression-guard",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "qa",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/qa-engineer.md"
          }
        ]
      },
      "docs": [
        {
          "name": "TEST_CASE.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/{iteration}/TEST_CASE.md",
          "required": true,
          "description": "Test case document for the bug fix including reproduction steps and verification results",
          "content_rules": [
            "Must contain: reproduction steps, expected result, actual result",
            "Regression test cases required for bugfixes"
          ],
          "template": "{TEAM_PATH}/templates/bug-test-template.md"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ],
      "on_exit": [
        {
          "action": "custom",
          "name": "output-guard-check",
          "message": "Verify Output Guard 5-step protocol completed"
        }
      ]
    },
    {
      "id": "gate-completion",
      "type": "gate",
      "name": "Completion Gate",
      "description": "Final gate verifying all deliverables exist, Output Guard passed, and user confirmation received",
      "config": {
        "conditions": [
          {
            "type": "deliverables_complete",
            "deliverables": [
              "RCA.md",
              "FIX.md",
              "SCOPE.md",
              "TEST_CASE.md"
            ]
          },
          {
            "type": "tests_pass",
            "threshold": "100%"
          },
          {
            "type": "no_regressions"
          },
          {
            "type": "custom",
            "check": "Output Guard Summary all passed",
            "required": true
          },
          {
            "type": "custom",
            "check": "User confirmation received",
            "required": true
          },
          {
            "type": "custom",
            "required": true,
            "check": "AC Compliance Matrix no failures"
          },
          {
            "type": "custom",
            "required": true,
            "check": "SCOPE.md generated"
          },
          {
            "type": "custom",
            "required": true,
            "check": "API changes: frontend-backend interface/path/param/response match checked"
          }
        ],
        "on_pass": "terminal-success",
        "on_fail": "phase-verify"
      }
    },
    {
      "id": "terminal-success",
      "type": "terminal",
      "name": "Bug Fixed",
      "description": "Bug fix completed and verified successfully",
      "config": {
        "status": "success",
        "message": "Bug fix flow completed successfully"
      },
      "on_exit": [
        {
          "action": "custom",
          "name": "handoff-doc",
          "message": "Generate handoff document at session end"
        }
      ]
    },
    {
      "id": "terminal-reject",
      "type": "terminal",
      "name": "Rejected",
      "description": "Bug report rejected at entry gate",
      "config": {
        "status": "rejected",
        "message": "Bug report does not meet minimum information requirements"
      }
    },
    {
      "id": "terminal-failed",
      "type": "terminal",
      "name": "Max Iterations Reached",
      "description": "Bug fix failed after maximum R-iterations, requires escalation",
      "config": {
        "status": "failed",
        "message": "Bug fix failed after 3 R-iterations, needs human escalation"
      }
    }
  ],
  "edges": [
    {
      "id": "e-triage-gate",
      "from": "phase-triage",
      "to": "gate-entry"
    },
    {
      "id": "e-gate-investigate",
      "from": "gate-entry",
      "to": "phase-investigate",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-gate-reject",
      "from": "gate-entry",
      "to": "terminal-reject",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    },
    {
      "id": "e-investigate-fix",
      "from": "phase-investigate",
      "to": "phase-fix"
    },
    {
      "id": "e-fix-gate",
      "from": "phase-fix",
      "to": "gate-quality"
    },
    {
      "id": "e-gate-verify",
      "from": "gate-quality",
      "to": "branch-r-iteration",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-gate-fix-retry",
      "from": "gate-quality",
      "to": "phase-fix",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    },
    {
      "id": "e-branch-verify",
      "from": "branch-r-iteration",
      "to": "phase-verify"
    },
    {
      "id": "e-branch-fix",
      "from": "branch-r-iteration",
      "to": "phase-fix"
    },
    {
      "id": "e-branch-failed",
      "from": "branch-r-iteration",
      "to": "terminal-failed"
    },
    {
      "id": "e-verify-completion",
      "from": "phase-verify",
      "to": "gate-completion"
    },
    {
      "id": "e-completion-success",
      "from": "gate-completion",
      "to": "terminal-success",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-completion-verify",
      "from": "gate-completion",
      "to": "phase-verify",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    }
  ]
}