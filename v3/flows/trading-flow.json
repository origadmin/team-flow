{
  "version": "v3",
  "metadata": {
    "name": "trading-flow",
    "description": "Trading analysis flow: Data Collection → Gate → Bull/Bear Debate → Gate → Trading Decision → Risk Assessment → Gate → Final Report → Terminal",
    "author": "team-flow",
    "created_at": "2026-05-20T00:00:00Z",
    "tags": [
      "trading",
      "finance",
      "analysis",
      "risk-management"
    ]
  },
  "config": {
    "task_type": "analysis",
    "auto_dispatch": true,
    "parallel_limit": 4,
    "timeout_minutes": 240
  },
  "variables": {
    "DOCS_INTERNAL": "",
    "TEAM_PATH": "",
    "task_id": "",
    "SKILL_PATH": "",
    "PROJECT_PATH": "",
    "domain": "trading"
  },
  "components": {
    "roles": [],
    "rules": [],
    "tools": [
      {
        "id": "task",
        "name": "Task Manager",
        "type": "builtin",
        "commands": [
          "show",
          "update",
          "append"
        ],
        "scope": "docs"
      },
      {
        "id": "file-write",
        "name": "File Writer",
        "type": "builtin",
        "scope": "docs"
      },
      {
        "id": "search",
        "name": "Codebase Search",
        "type": "builtin",
        "scope": "all"
      }
    ],
    "gates": [
      {
        "id": "data-completeness",
        "name": "Data Completeness Gate",
        "type": "deliverable_check",
        "source": "trading-flow"
      },
      {
        "id": "debate-quality",
        "name": "Debate Quality Gate",
        "type": "quality_check",
        "source": "trading-flow"
      },
      {
        "id": "risk-tolerance",
        "name": "Risk Tolerance Gate",
        "type": "quality_check",
        "source": "trading-flow"
      }
    ]
  },
  "nodes": [
    {
      "id": "ta3k",
      "type": "phase",
      "name": "Data Collection",
      "description": "四面数据采集阶段：技术面、基本面、新闻面、情绪面分析师分别采集和整理各自领域的数据，产出标准化分析报告",
      "config": {
        "role": "Analyst",
        "auto_dispatch": true,
        "timeout_minutes": 60,
        "deliverables": [
          "TECHNICAL_ANALYSIS.md",
          "FUNDAMENTAL_ANALYSIS.md",
          "NEWS_ANALYSIS.md",
          "SENTIMENT_ANALYSIS.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "r4t1",
            "source": "team"
          },
          {
            "ref": "r5m2",
            "source": "team"
          },
          {
            "ref": "r6n8",
            "source": "team"
          },
          {
            "ref": "r7p3",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "t1a",
            "source": "builtin"
          },
          {
            "ref": "t5e",
            "source": "builtin"
          },
          {
            "ref": "t3c",
            "source": "builtin"
          },
          {
            "ref": "t8h",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "file-write"
          },
          {
            "ref": "search"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "TECHNICAL_ANALYSIS.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/TECHNICAL_ANALYSIS.md",
          "required": true,
          "description": "技术分析报告：K线形态、趋势判断、支撑阻力位、技术指标信号（MACD/RSI/布林带等）、交易信号汇总",
          "content_rules": [
            "必须包含至少3个技术指标分析",
            "必须标注数据来源和时间戳",
            "必须明确趋势方向判断（上涨/下跌/震荡）",
            "支撑阻力位必须给出具体价格"
          ]
        },
        {
          "name": "FUNDAMENTAL_ANALYSIS.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/FUNDAMENTAL_ANALYSIS.md",
          "required": true,
          "description": "基本面分析报告：财务数据、估值指标、行业地位、盈利能力、成长性评估",
          "content_rules": [
            "必须包含PE/PB/ROE等核心估值指标",
            "必须包含营收和利润趋势分析",
            "必须标注数据来源和报告期",
            "必须给出估值结论（高估/合理/低估）"
          ]
        },
        {
          "name": "NEWS_ANALYSIS.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/NEWS_ANALYSIS.md",
          "required": true,
          "description": "新闻分析报告：重大新闻事件、政策变动、行业动态、事件影响评估",
          "content_rules": [
            "必须列出近期影响市场的重大新闻",
            "每条新闻必须评估对目标资产的影响方向和程度",
            "必须标注新闻发布时间和来源",
            "必须区分已确认事件和传闻"
          ]
        },
        {
          "name": "SENTIMENT_ANALYSIS.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/SENTIMENT_ANALYSIS.md",
          "required": true,
          "description": "情绪分析报告：恐惧贪婪指数、市场情绪指标、资金流向、投资者行为分析",
          "content_rules": [
            "必须包含恐惧贪婪指数或等效情绪指标",
            "必须包含资金流向数据",
            "必须评估当前情绪状态（极度恐惧/恐惧/中性/贪婪/极度贪婪）",
            "必须标注情绪指标的数据时间"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "gb7m",
      "type": "gate",
      "name": "Data Completeness Check",
      "description": "验证四面数据采集是否完整：技术面、基本面、新闻面、情绪面分析报告是否全部产出且内容充实",
      "config": {
        "conditions": [
          {
            "type": "deliverables_complete",
            "required": [
              "TECHNICAL_ANALYSIS.md",
              "FUNDAMENTAL_ANALYSIS.md",
              "NEWS_ANALYSIS.md",
              "SENTIMENT_ANALYSIS.md"
            ]
          }
        ],
        "on_pass": "dc5p",
        "on_fail": "ta3k",
        "auto_retry": {
          "max_attempts": 2,
          "delay_minutes": 5
        }
      }
    },
    {
      "id": "dc5p",
      "type": "phase",
      "name": "Bull/Bear Debate",
      "description": "多空辩论阶段：多头研究员和空头研究员基于数据采集结果分别论证看多和看空观点，研究主管主持辩论并汇总结论",
      "config": {
        "role": "ResearchDirector",
        "auto_dispatch": true,
        "timeout_minutes": 45,
        "deliverables": [
          "DEBATE_SUMMARY.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "r8q9",
            "source": "team"
          },
          {
            "ref": "r9w4",
            "source": "team"
          },
          {
            "ref": "r0a5",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "t1a",
            "source": "builtin"
          },
          {
            "ref": "t3c",
            "source": "builtin"
          },
          {
            "ref": "t8h",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "file-write"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "DEBATE_SUMMARY.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/DEBATE_SUMMARY.md",
          "required": true,
          "description": "多空辩论总结：多头论据、空头论据、辩论焦点、研究主管综合评判、多空力量对比结论",
          "content_rules": [
            "必须完整呈现多头和空头双方的核心论据",
            "每方论据必须引用数据采集阶段的具体数据支撑",
            "研究主管必须给出明确的综合评判结论",
            "必须标注辩论中未解决的分歧点"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "design"
        }
      ]
    },
    {
      "id": "qd2n",
      "type": "gate",
      "name": "Debate Quality Check",
      "description": "验证多空辩论质量：双方论据是否充分、是否有数据支撑、研究主管是否给出明确结论",
      "config": {
        "conditions": [
          {
            "type": "deliverables_complete",
            "required": [
              "DEBATE_SUMMARY.md"
            ]
          }
        ],
        "on_pass": "jv8r",
        "on_fail": "ta3k",
        "auto_retry": {
          "max_attempts": 2,
          "delay_minutes": 5
        }
      }
    },
    {
      "id": "jv8r",
      "type": "phase",
      "name": "Trading Decision",
      "description": "交易决策阶段：交易员根据多空辩论结论制定具体交易方案，首席策略官提供策略指导",
      "config": {
        "role": "Trader",
        "auto_dispatch": true,
        "timeout_minutes": 30,
        "deliverables": [
          "TRADING_DECISION.md"
        ]
      },
      "components": {
