            "type": "file_write",
            "allowed_paths": [
              "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "TRADING_DECISION.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/TRADING_DECISION.md",
          "required": true,
          "description": "交易决策方案：BUY/SELL/HOLD建议、入场价位、止损位、止盈位、仓位大小、交易时机、策略官意见",
          "content_rules": [
            "必须明确给出BUY/SELL/HOLD建议",
            "必须包含入场价位和依据",
            "必须包含止损位和止损逻辑",
            "必须包含止盈位（至少2个目标位）",
            "必须包含仓位大小和计算依据",
            "必须包含风险收益比计算",
            "策略官必须签署意见"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "rk6s",
      "type": "phase",
      "name": "Risk Assessment",
      "description": "三方风险评估阶段：激进、保守、中性风险分析师分别评估交易方案的风险，风险主管监督并汇总风险评估结论",
      "config": {
        "role": "RiskSupervisor",
        "auto_dispatch": true,
        "timeout_minutes": 30,
        "deliverables": [
          "RISK_ASSESSMENT.md"
        ]
      },
      "components": {
        "roles": [
          {
            "ref": "r2c7",
