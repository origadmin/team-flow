              "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "RISK_ASSESSMENT.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/RISK_ASSESSMENT.md",
          "required": true,
          "description": "风险评估报告：激进视角评估、保守视角评估、中性视角评估、风险主管综合意见、风险等级判定",
          "content_rules": [
            "必须包含三方（激进/保守/中性）独立评估意见",
            "每方评估必须给出具体风险等级（低/中/高/极高）",
            "必须计算最大可能亏损金额和比例",
            "风险主管必须给出是否通过风险评估的明确结论",
            "必须包含风险提示和免责声明"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ]
    },
    {
      "id": "yw4w",
      "type": "gate",
      "name": "Risk Tolerance Check",
      "description": "验证交易方案风险是否在可容忍范围内：风险评估是否通过、风险等级是否可接受",
      "config": {
        "conditions": [
          {
            "type": "deliverables_complete",
            "required": [
              "RISK_ASSESSMENT.md"
            ]
          }
        ],
        "on_pass": "fp9j",
        "on_fail": "rx02",
        "auto_retry": {
          "max_attempts": 1,
          "delay_minutes": 5
        }
      }
    },
    {
      "id": "fp9j",
      "type": "phase",
      "name": "Final Report",
      "description": "最终报告阶段：首席策略官整合所有分析结果，签发最终投资分析报告，包含BUY/SELL/HOLD建议及完整操作方案",
      "config": {
        "role": "ChiefStrategist",
        "auto_dispatch": true,
        "timeout_minutes": 30,
        "deliverables": [
          "FINAL_REPORT.md"
        ]
      },
