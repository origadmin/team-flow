        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "FINAL_REPORT.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/FINAL_REPORT.md",
          "required": true,
          "description": "最终投资分析报告：分析标的概述、四面数据摘要、多空辩论结论、交易建议（BUY/SELL/HOLD）、操作方案、风险评估摘要、风险提示和免责声明",
          "content_rules": [
            "必须包含明确的BUY/SELL/HOLD建议",
            "必须整合技术面、基本面、新闻面、情绪面分析结论",
            "必须包含完整操作方案（入场/止损/止盈/仓位）",
            "必须包含风险评估摘要和风险等级",
            "必须包含风险提示和免责声明",
            "策略官必须签署最终意见"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "review"
        }
      ]
    },
    {
      "id": "sc01",
      "type": "terminal",
      "name": "Analysis Complete",
      "description": "交易分析流程完成，已输出BUY/SELL/HOLD建议及完整操作方案",
      "config": {
        "status": "success",
        "message": "Trading analysis flow completed successfully with recommendation"
      }
    },
    {
      "id": "rx02",
      "type": "terminal",
      "name": "Risk Exceeded",
      "description": "交易方案风险超出容忍度，无法给出投资建议",
      "config": {
        "status": "rejected",
        "message": "Trading proposal exceeds risk tolerance — no recommendation issued"
      }
    }
