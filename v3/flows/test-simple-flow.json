{
  "version": "v3",
  "metadata": {
    "name": "test-simple-flow",
    "description": "Minimal linear flow for testing v3-create skill compliance",
    "tags": ["test", "simple"]
  },
  "config": {
    "task_type": "feature",
    "auto_dispatch": true,
    "parallel_limit": 1,
    "timeout_minutes": 60
  },
  "variables": {
    "docs_path": "",
    "TEAM_PATH": "",
    "task_id": "",
    "SKILL_PATH": "",
    "PROJECT_PATH": ""
  },
  "components": {
    "roles": [
      {
        "id": "triage",
        "name": "Triage Agent",
        "source": "builtin",
        "capabilities": ["classify", "dispatch"]
      },
      {
        "id": "dev",
        "name": "Developer",
        "source": "builtin",
        "capabilities": ["implement", "debug"]
      }
    ],
    "rules": [
      {
        "id": "output-guard",
        "name": "Output Guard Protocol",
        "description": "5-step self-assessment before completion: AC compliance matrix, compile check, test execution, self-critique, output summary",
        "source": "framework",
        "type": "process_constraint",
        "enforcement": "hard"
      }
    ],
    "tools": [],
    "skills": [],
    "gates": []
  },
  "nodes": [
    {
      "id": "x9k2",
      "type": "phase",
      "name": "Triage",
      "description": "Classify and dispatch the task",
      "config": {
        "role": "Triage",
        "auto_dispatch": true,
        "timeout_minutes": 15
      },
      "components": {
        "roles": [
          { "ref": "triage", "source": "builtin" }
        ],
        "rules": [
          { "ref": "output-guard", "source": "framework" }
        ]
      },
      "on_enter": [
        { "action": "update_task_phase", "phase": "triage" }
      ]
    },
    {
      "id": "m4p1",
      "type": "phase",
      "name": "Implement",
      "description": "Implement the task",
      "config": {
        "role": "Dev",
        "auto_dispatch": true,
        "timeout_minutes": 45
      },
      "components": {
        "roles": [
          { "ref": "dev", "source": "builtin" }
        ],
        "rules": [
          { "ref": "output-guard", "source": "framework" }
        ]
      },
      "docs": [
        {
          "name": "IMPL.md",
          "format": "markdown",
          "path": "{docs_path}/{task_id}/IMPL.md",
          "required": true,
          "description": "Implementation notes"
        }
      ],
      "on_enter": [
        { "action": "update_task_phase", "phase": "implement" }
      ]
    },
    {
      "id": "s0q7",
      "type": "terminal",
      "name": "Completed",
      "description": "Task completed successfully",
      "config": {
        "status": "success",
        "message": "Task completed successfully"
      }
    }
  ],
  "edges": [
    {
      "id": "e-x9k2-m4p1",
      "from": "x9k2",
      "to": "m4p1"
    },
    {
      "id": "e-m4p1-s0q7",
      "from": "m4p1",
      "to": "s0q7"
    }
  ]
}
