          "skills": ["prompts/devops.md"],
          "workspace": "./workspace/devops",
          "standards": ["workflows/shared.md"]
        },
        {
          "id": "pm",
          "name": "产品经理",
          "subagent_type": "pm-documenter",
          "skills": ["prompts/pm.md"],
          "workspace": "./workspace/pm",
          "standards": ["workflows/shared.md", "workflows/roles/requirements-standards.md"]
        },
        {
          "id": "analysis",
          "name": "分析专家",
          "subagent_type": "analysis-expert",
