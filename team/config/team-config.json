        {
          "id": "ui-designer",
          "name": "UI 设计师",
          "subagent_type": "ui-designer",
          "skills": ["prompts/ui-designer.md"],
          "standards": ["workflows/shared.md", "workflows/roles/ui-standards.md"]
        }
      ],
      "workflow": "workflows/shared.md",
      "standards": "workflows/output-standards.md"
    },
    "framework-dev": {
      "name": "框架开发团队",
      "description": "负责 toolkits/runtime/contrib 框架模块开发",
      "standards": "workflows/output-standards.md",
      "members": [
        {
          "id": "framework-architect",
          "name": "框架架构师",
          "subagent_type": "tech-lead-architect",
          "skills": ["prompts/framework-architect.md"],
          "workspace": "./workspace/framework-architect",
          "modules": ["toolkits", "runtime", "contrib"],
          "standards": ["workflows/shared.md", "workflows/roles/development-standards.md"]
        },
        {
          "id": "dev",
          "name": "开发工程师（框架）",
          "subagent_type": "developer-engineer",
          "skills": ["prompts/dev.md"],
          "workspace": "./workspace/dev",
          "routingRules": [
            {
              "type": "keyword",
              "patterns": ["toolkits", "cache", "codec", "crypto", "metrics"],
              "techStack": "go-toolkits"
            },
            {
              "type": "keyword",
              "patterns": ["runtime", "DI", "依赖注入", "Wire", "go-kratos"],
              "techStack": "go-runtime"
            },
            {
              "type": "keyword",
              "patterns": ["contrib", "服务发现", "Consul", "Etcd", "消息队列"],
              "techStack": "go-contrib"
            }
          ],
          "standards": ["workflows/shared.md", "workflows/roles/development-standards.md"]
        }
      ],
      "workflow": "workflows/framework-workflow.md",
      "standards": "workflows/output-standards.md"
    }
  },
  "common": {
    "codeStandards": {
      "language": "Go/TypeScript",
      "noChineseComments": true,
      "formatter": ["gofmt", "prettier"],
      "linter": ["golangci-lint", "eslint"],
      "testCoverage": 80
    },
    "documentStructure": {
      "requirements": "docs/requirements/{feature}/",
      "design": "docs/design/{feature}/",
      "test": "docs/test/{feature}/",
      "release": "docs/release/v{version}/",
      "meta": "docs/meta/"
    },
    "tools": {
      "proto": "buf",
      "ci": "GitHub Actions",
      "container": "Docker",
      "orchestration": "Kubernetes"
    }
  }
