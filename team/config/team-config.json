{
  "version": "7.0",
  "updated": "2026-04-25",
  "_comment": "workspace 路径使用相对路径，相对于 {TEAM_PATH} 目录",
  "_comment_subagent": "subagent_type 映射到 Trae Task 工具的 subagent_type 参数",
  "_comment_routing": "routingRules 定义关键词/项目类型到角色的映射，供多 Agent 工具（trae/Gemini CLI 等）使用",
  "teams": {
    "app-dev": {
      "name": "应用开发团队",
      "description": "负责 {project-name} 等应用项目开发",
      "standards": "workflows/output-standards.md",
      "members": [
        {
          "id": "triage",
          "name": "分发工具",
          "subagent_type": "self",
          "skills": ["prompts/triage.md"],
          "standards": ["workflows/shared.md", "workflows/roles/triage-standards.md"]
        },
        {
          "id": "tech-lead",
          "name": "技术总监",
          "subagent_type": "tech-lead-architect",
          "skills": ["prompts/tech-lead.md"],
          "workspace": "./workspace/tech-lead",
          "standards": ["workflows/shared.md", "workflows/roles/analysis-standards.md"]
        },
        {
          "id": "dev",
          "name": "开发工程师（统一）",
          "subagent_type": "developer-engineer",
          "skills": ["prompts/dev.md"],
          "workspace": "./workspace/dev",
          "routingRules": [
            {
              "type": "keyword",
              "patterns": ["后端", "API", "gRPC", "数据库", "微服务", "Go", "业务逻辑"],
              "techStack": "go-kratos"
            },
            {
              "type": "keyword",
              "patterns": ["前端", "React", "组件", "UI", "页面", "前端开发"],
              "techStack": "react"
            },
            {
              "type": "keyword",
              "patterns": ["Android", "Kotlin", "移动端", "App", "原生开发"],
              "techStack": "android"
            },
            {
              "type": "keyword",
              "patterns": ["iOS", "Swift", "移动端", "App", "原生开发"],
              "techStack": "ios"
            }
          ],
          "standards": ["workflows/shared.md", "workflows/roles/development-standards.md", "workflows/roles/bugfix-standards.md"]
        },
        {
          "id": "bugfix",
          "name": "Bug 修复专家",
          "subagent_type": "bugfix-expert",
          "skills": ["prompts/bugfix.md"],
          "standards": ["workflows/shared.md", "workflows/roles/bugfix-standards.md"]
