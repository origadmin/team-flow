{
  "components": {
    "roles": [],
    "rules": [],
    "skills": [],
    "tools": [
      {
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ],
        "id": "task",
        "name": "Task CLI",
        "type": "cli"
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ]
  },
  "config": {
    "auto_dispatch": true,
    "parallel_limit": 1,
    "task_type": "release",
    "timeout_minutes": 120
  },
  "edges": [
    {
      "from": "phase-triage",
      "id": "e-triage-gate",
      "to": "gate-entry"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-prepare",
      "to": "phase-prepare",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-reject",
      "to": "terminal-reject",
      "type": "conditional"
    },
    {
      "from": "phase-prepare",
      "id": "e-prepare-gate",
      "to": "gate-release-readiness"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-release-readiness",
      "id": "e-gate-deploy",
      "to": "phase-deploy",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-release-readiness",
      "id": "e-gate-prepare-retry",
      "to": "phase-prepare",
      "type": "conditional"
    },
    {
      "from": "phase-deploy",
      "id": "e-deploy-verify",
      "to": "phase-verify"
    },
    {
      "from": "phase-verify",
      "id": "e-verify-completion",
      "to": "gate-completion"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-success",
      "to": "terminal-success",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-rollback",
      "to": "phase-rollback",
      "type": "conditional"
    },
    {
      "from": "phase-rollback",
      "id": "e-rollback-failed",
      "to": "terminal-failed"
    }
  ],
  "metadata": {
    "author": "team-flow",
    "description": "Release flow: Triage → Gate → Prepare → Release Readiness Gate → Deploy → Verify → Completion Gate → Terminal",
    "name": "release-flow",
    "tags": [
      "release",
      "deployment",
      "software"
    ]
  },
  "nodes": [
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/triage.md",
            "ref": "triage",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "triage",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d1a",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "role": "Triage"
      },
      "description": "Classify and validate the release request",
      "docs": [
        {
          "description": "Release triage record with version, scope, and dispatch decision",
          "format": "markdown",
          "name": "TRIAGE.md",
          "path": "{DOCS_INTERNAL}/{task_id}/TRIAGE.md",
          "required": true
        }
      ],
      "id": "phase-triage",
      "name": "Release Triage",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "type": "task_exists"
          },
          {
            "expected": "release",
            "type": "type_matches"
          }
        ],
        "on_fail": "terminal-reject",
        "on_pass": "phase-prepare"
      },
      "description": "Validate release request has version and scope information",
      "id": "gate-entry",
      "name": "Entry Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/devops.md",
            "ref": "devops",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "devops",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d2b",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "commands": [
              "show",
              "update",
              "append"
            ],
            "ref": "task"
          },
          {
            "ref": "search"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "RELEASE_NOTES.md",
          "CHANGELOG.md"
        ],
        "role": "DevOps"
      },
      "description": "Prepare release artifacts: version bump, changelog, release notes",
      "docs": [
        {
          "description": "Release notes documenting version, changes, and breaking changes",
          "format": "markdown",
          "name": "RELEASE_NOTES.md",
          "path": "{DOCS_INTERNAL}/{task_id}/RELEASE_NOTES.md",
          "required": true
        },
        {
          "description": "Changelog entry for this release version",
          "format": "markdown",
          "name": "CHANGELOG.md",
          "path": "{DOCS_INTERNAL}/{task_id}/CHANGELOG.md",
          "required": true
        }
      ],
      "id": "phase-prepare",
      "name": "Release Preparation",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "prepare"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "threshold": "0 errors",
            "type": "lint_pass"
          },
          {
            "check": "CHANGELOG.md exists and non-empty",
            "required": true,
            "type": "custom"
          },
          {
            "check": "RELEASE_NOTES.md exists and non-empty",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Version number updated",
            "required": true,
            "type": "custom"
          },
          {
            "check": "CI pipeline passes",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-prepare",
        "on_pass": "phase-deploy"
      },
      "description": "Verify release is ready: CI passes, changelog exists, version bumped",
      "id": "gate-release-readiness",
      "name": "Release Readiness Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/devops.md",
            "ref": "devops",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "devops",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d4e",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-ops"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "DEPLOY.md"
        ],
        "role": "DevOps"
      },
      "description": "Deploy the release to target environment",
      "docs": [
        {
          "description": "Deployment record: environment, version, timestamp, rollback plan",
          "format": "markdown",
          "name": "DEPLOY.md",
          "path": "{DOCS_INTERNAL}/{task_id}/DEPLOY.md",
          "required": true
        }
      ],
      "id": "phase-deploy",
      "name": "Deployment",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "deploy"
        }
      ],
      "type": "phase"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/devops.md",
            "ref": "devops",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "devops",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d2b",
            "source": "framework"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "SMOKE_TEST.md"
        ],
        "role": "DevOps"
      },
      "description": "Run smoke tests and verify deployment health",
      "docs": [
        {
          "description": "Smoke test results and deployment health check",
          "format": "markdown",
          "name": "SMOKE_TEST.md",
          "path": "{DOCS_INTERNAL}/{task_id}/SMOKE_TEST.md",
          "required": true
        }
      ],
      "id": "phase-verify",
      "name": "Post-Deploy Verification",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ],
      "on_exit": [
        {
          "action": "custom",
          "message": "Verify Output Guard 5-step protocol completed",
          "name": "output-guard-check"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "deliverables": [
              "RELEASE_NOTES.md",
              "CHANGELOG.md",
              "DEPLOY.md",
              "SMOKE_TEST.md"
            ],
            "type": "deliverables_complete"
          },
          {
            "check": "Output Guard Summary all passed",
            "required": true,
            "type": "custom"
          },
          {
            "check": "User confirmation received",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Smoke tests passed",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-rollback",
        "on_pass": "terminal-success"
      },
      "description": "Final gate verifying all deliverables exist and smoke tests passed",
      "id": "gate-completion",
      "name": "Completion Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/devops.md",
            "ref": "devops",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "devops",
            "source": "team"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "role": "DevOps"
      },
      "description": "Rollback the deployment to previous version",
      "docs": [
        {
          "description": "Rollback record: reason, previous version, timestamp, verification",
          "format": "markdown",
          "name": "ROLLBACK.md",
          "path": "{DOCS_INTERNAL}/{task_id}/ROLLBACK.md",
          "required": true
        }
      ],
      "id": "phase-rollback",
      "name": "Rollback",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "rollback"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "message": "Release flow completed successfully",
        "status": "success"
      },
      "description": "Release completed and deployed successfully",
      "id": "terminal-success",
      "name": "Released",
      "on_exit": [
        {
          "action": "custom",
          "message": "Generate handoff document at session end",
          "name": "handoff-doc"
        }
      ],
      "type": "terminal"
    },
    {
      "config": {
        "message": "Release request does not meet requirements",
        "status": "rejected"
      },
      "description": "Release request rejected at entry gate",
      "id": "terminal-reject",
      "name": "Rejected",
      "type": "terminal"
    },
    {
      "config": {
        "message": "Release failed and was rolled back",
        "status": "failed"
      },
      "description": "Release failed and was rolled back",
      "id": "terminal-failed",
      "name": "Rolled Back",
      "type": "terminal"
    }
  ],
  "variables": {
    "DOCS_INTERNAL": "",
    "TEAM_PATH": "",
    "task_id": ""
  },
  "version": "v3"
}
