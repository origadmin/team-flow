{
  "version": "v3",
  "metadata": {
    "name": "promo-video-flow",
    "description": "Product promo video creation: Creative Brief → Storyboard → Asset Production → Music Design → HyperFrames Compositing → QC → Terminal",
    "author": "team-flow",
    "tags": [
      "promo-video",
      "video-production",
      "product-launch"
    ]
  },
  "config": {
    "task_type": "development",
    "domain": "promo-video",
    "auto_dispatch": true,
    "parallel_limit": 3,
    "timeout_minutes": 480
  },
  "variables": {
    "DOCS_INTERNAL": "",
    "TEAM_PATH": "",
    "task_id": "",
    "SKILL_PATH": "",
    "workspace": "",
    "domain": "promo-video"
  },
  "components": {
    "roles": [],
    "rules": [],
    "tools": [
      {
        "id": "task",
        "name": "Task Manager",
        "type": "builtin",
        "commands": [
          "show",
          "update",
          "append"
        ],
        "scope": "docs"
      },
      {
        "id": "file-write",
        "name": "File Writer",
        "type": "builtin",
        "scope": "docs"
      },
      {
        "id": "search",
        "name": "Codebase Search",
        "type": "builtin",
        "scope": "all"
      }
    ]
  },
  "nodes": [
    {
      "id": "pc01",
      "type": "phase",
      "name": "Creative Brief",
      "description": "Extract product selling points from product URL, define emotional anchor and core message, produce creative brief",
      "config": {
        "role": "CreativeStrategist"
      },
      "components": {
        "roles": [
          {
            "ref": "creative-strategist",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "v1a",
            "source": "flow"
          },
          {
            "ref": "v3c",
            "source": "flow"
          },
          {
            "ref": "v6f",
            "source": "flow"
          }
        ]
      },
      "docs": [
        {
          "name": "BRIEF.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/BRIEF.md",
          "required": true,
          "description": "Creative brief: one-line core message, target audience, emotional tone, selling point priority, emotional anchor, brand constraints"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "ps02",
      "type": "phase",
      "name": "Storyboard",
      "description": "Create shot-by-shot storyboard with timing, narration, and visual style guide",
      "config": {
        "role": "Scriptwriter"
      },
      "components": {
        "roles": [
          {
            "ref": "scriptwriter",
            "source": "team"
          },
          {
            "ref": "visual-director",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "v1a",
            "source": "flow"
          },
          {
            "ref": "v3c",
            "source": "flow"
          },
          {
            "ref": "v4d",
            "source": "flow"
          },
          {
            "ref": "v6f",
            "source": "flow"
          }
        ]
      },
      "docs": [
        {
          "name": "STORYBOARD.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/STORYBOARD.md",
          "required": true,
          "description": "Shot-by-shot storyboard: shot number, duration, visual description, voiceover/subtitle text, emotion tag, total 60-90 seconds"
        },
        {
          "name": "VISUAL_GUIDE.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/VISUAL_GUIDE.md",
          "required": true,
          "description": "Visual style guide: color palette, composition rules, transition style, typography, AI generation prompt templates, reference frames"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "design"
        }
      ]
    },
    {
      "id": "pg03",
      "type": "gate",
      "name": "Script Review Gate",
      "description": "Verify storyboard is complete with shot-by-shot breakdown and visual style guide",
      "config": {
        "conditions": [
          {
            "type": "deliverables_complete",
            "required": [
              "STORYBOARD.md",
              "VISUAL_GUIDE.md"
            ]
          }
        ],
        "on_pass": "pm04",
        "on_fail": "ps02",
        "auto_retry": {
          "max_attempts": 2,
          "delay_minutes": 5
        }
      }
    },
    {
      "id": "pm04",
      "type": "phase",
      "name": "Music Design",
      "description": "Design music narrative: emotion curve, BPM planning, sound design, and licensing/generation plan",
      "config": {
        "role": "MusicDirector"
      },
      "components": {
        "roles": [
          {
            "ref": "music-director",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "v5e",
            "source": "flow"
          },
          {
            "ref": "v2b",
            "source": "flow"
          },
          {
            "ref": "v6f",
            "source": "flow"
          }
        ]
      },
      "docs": [
        {
          "name": "MUSIC_BRIEF.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/MUSIC_BRIEF.md",
          "required": true,
          "description": "Music brief: emotion curve, BPM planning per section, sound design aligned with product features, licensing/generation plan, entry/exit points"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "design"
        }
      ]
    },
    {
      "id": "pp05",
      "type": "phase",
      "name": "Asset Production & Compositing",
      "description": "Generate/collect visual assets, HyperFrames editing and compositing, voiceover synthesis, subtitle creation, produce draft cut",
      "config": {
        "role": "Producer"
      },
      "components": {
        "roles": [
          {
            "ref": "producer",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "v4d",
            "source": "flow"
          },
          {
            "ref": "v7g",
            "source": "flow"
          },
          {
            "ref": "v2b",
            "source": "flow"
          },
          {
            "ref": "v6f",
            "source": "flow"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-write"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{workspace}/"
            ]
          },
          {
            "type": "timeout",
            "minutes": 120
          }
        ]
      },
      "docs": [
        {
          "name": "ASSET_LOG.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/ASSET_LOG.md",
          "required": true,
          "description": "Asset production log: source/type of each asset, AI generation parameters, resolution, duration, file references"
        },
        {
          "name": "DRAFT_CUT.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/DRAFT_CUT.md",
          "required": true,
          "description": "Draft cut report: timeline breakdown, shot assembly, audio sync status, subtitle placement, technical parameters, file path to video"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "pq06",
      "type": "gate",
      "name": "Cut Review Gate",
      "description": "Verify draft cut exists with all shots composited and audio synced",
      "config": {
        "conditions": [
          {
            "type": "deliverables_complete",
            "required": [
              "DRAFT_CUT.md"
            ]
          },
          {
            "type": "custom",
            "check": "Video file exists at the path specified in DRAFT_CUT.md with all shots composited and audio synced"
          }
        ],
        "on_pass": "pv07",
        "on_fail": "pp05",
        "auto_retry": {
          "max_attempts": 2,
          "delay_minutes": 5
        }
      }
    },
    {
      "id": "pv07",
      "type": "phase",
      "name": "Quality Control",
      "description": "Frame-by-frame QC: brand accuracy, audio-visual sync, narrative coherence, technical standards, multi-version adaptation",
      "config": {
        "role": "QCReviewer"
      },
      "components": {
        "roles": [
          {
            "ref": "qc-reviewer",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "v1a",
            "source": "flow"
          },
          {
            "ref": "v2b",
            "source": "flow"
          },
          {
            "ref": "v3c",
            "source": "flow"
          },
          {
            "ref": "v4d",
            "source": "flow"
          },
          {
            "ref": "v7g",
            "source": "flow"
          },
          {
            "ref": "v8h",
            "source": "flow"
          },
          {
            "ref": "v6f",
            "source": "flow"
          }
        ]
      },
      "docs": [
        {
          "name": "QC_REPORT.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/QC_REPORT.md",
          "required": true,
          "description": "QC report: frame-by-frame check results, brand accuracy, audio-visual sync status, narrative coherence, technical compliance, issues found and fixes applied"
        },
        {
          "name": "FINAL_DELIVERY.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/FINAL_DELIVERY.md",
          "required": true,
          "description": "Final delivery manifest: video file paths, technical specs, version list (60s/90s), checksum, brand sign-off"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ]
    },
    {
      "id": "pt00",
      "type": "terminal",
      "name": "Delivered",
      "description": "Product promo video delivered successfully",
      "config": {
        "status": "success",
        "message": "Product promo video delivered successfully"
      }
    },
    {
      "id": "pr08",
      "type": "terminal",
      "name": "Revision Required",
      "description": "Video requires fundamental revision",
      "config": {
        "status": "rejected",
        "message": "Video requires fundamental revision"
      }
    }
  ],
  "edges": [
    {
      "id": "e-pc01-ps02",
      "from": "pc01",
      "to": "ps02"
    },
    {
      "id": "e-ps02-pg03",
      "from": "ps02",
      "to": "pg03"
    },
    {
      "id": "e-pg03-pm04",
      "from": "pg03",
      "to": "pm04",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-pg03-pr08",
      "from": "pg03",
      "to": "pr08",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    },
    {
      "id": "e-pm04-pp05",
      "from": "pm04",
      "to": "pp05"
    },
    {
      "id": "e-pp05-pq06",
      "from": "pp05",
      "to": "pq06"
    },
    {
      "id": "e-pq06-pv07",
      "from": "pq06",
      "to": "pv07",
      "type": "conditional",
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ]
    },
    {
      "id": "e-pq06-pp05",
      "from": "pq06",
      "to": "pp05",
      "type": "conditional",
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ]
    },
    {
      "id": "e-pv07-pt00",
      "from": "pv07",
      "to": "pt00"
    }
  ]
}
