{
  "components": {
    "roles": [],
    "rules": [],
    "skills": [
      {
        "description": "Design RESTful/gRPC API contracts with consistent naming and error handling",
        "id": "api-design",
        "name": "API Design",
        "path": "{TEAM_PATH}/skills/api-design/SKILL.md",
        "source": "builtin",
        "trigger": "manual"
      },
      {
        "description": "Protocol Buffer schema design and code generation",
        "id": "protobuf",
        "name": "Protobuf",
        "path": "{TEAM_PATH}/skills/protobuf/SKILL.md",
        "source": "builtin",
        "trigger": "manual"
      }
    ],
    "tools": [
      {
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ],
        "id": "task",
        "name": "Task CLI",
        "type": "cli"
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ]
  },
  "config": {
    "auto_dispatch": true,
    "parallel_limit": 3,
    "task_type": "feature",
    "timeout_minutes": 480
  },
  "edges": [
    {
      "from": "phase-triage",
      "id": "e-triage-gate",
      "to": "gate-entry"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-analyze",
      "to": "phase-analyze",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-reject",
      "to": "terminal-reject",
      "type": "conditional"
    },
    {
      "from": "phase-analyze",
      "id": "e-analyze-design",
      "to": "phase-design"
    },
    {
      "from": "phase-design",
      "id": "e-design-implement",
      "to": "phase-implement"
    },
    {
      "from": "phase-implement",
      "id": "e-implement-gate",
      "to": "gate-quality"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-quality",
      "id": "e-gate-verify",
      "to": "phase-verify",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-quality",
      "id": "e-gate-implement",
      "to": "phase-implement",
      "type": "conditional"
    },
    {
      "from": "phase-verify",
      "id": "e-verify-review",
      "to": "phase-review"
    },
    {
      "from": "phase-review",
      "id": "e-review-completion",
      "to": "gate-completion"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-success",
      "to": "terminal-success",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-review",
      "to": "phase-review",
      "type": "conditional"
    }
  ],
  "metadata": {
    "author": "team-flow",
    "description": "Standard feature development flow: Triage → Gate → Analyze → Design → Implement → Gate → Verify → Review → Terminal",
    "name": "feature-flow",
    "tags": [
      "feature",
      "default",
      "software"
    ]
  },
  "nodes": [
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/triage.md",
            "ref": "triage",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "triage",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d1a",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "role": "Triage"
      },
      "description": "Classify and dispatch the incoming task to the appropriate flow",
      "docs": [
        {
          "description": "Triage classification record with task type, priority, and dispatch decision",
          "format": "markdown",
          "name": "TRIAGE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/TRIAGE.md",
          "required": true
        }
      ],
      "id": "phase-triage",
      "name": "Task Triage",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "type": "task_exists"
          },
          {
            "expected": "feature",
            "type": "type_matches"
          }
        ],
        "on_fail": "terminal-reject",
        "on_pass": "phase-analyze"
      },
      "description": "Validate task exists and type matches feature",
      "id": "gate-entry",
      "name": "Entry Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/tech-lead.md",
            "ref": "tech-lead",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "tech-lead",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d8j",
            "source": "builtin"
          },
          {
            "ref": "d2b",
            "source": "framework"
          }
        ],
        "skills": [
          {
            "ref": "api-design"
          }
        ],
        "tools": [
          {
            "commands": [
              "show",
              "update",
              "append"
            ],
            "ref": "task"
          },
          {
            "ref": "search"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "SPEC.md",
          "AC.md"
        ],
        "role": "TechLead"
      },
      "description": "Analyze requirements and produce SPEC and acceptance criteria",
      "docs": [
        {
          "content_rules": [
            "Must contain: overview, requirements, constraints, dependencies"
          ],
          "description": "Feature specification document detailing requirements, scope, and constraints",
          "format": "markdown",
          "name": "SPEC.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/SPEC.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/prd-template.md"
        },
        {
          "content_rules": [
            "Must contain: acceptance criteria as testable assertions",
            "Each criterion must be verifiable (pass/fail)"
          ],
          "description": "Acceptance criteria with measurable conditions for feature completion",
          "format": "markdown",
          "name": "AC.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/AC.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/prd-template.md"
        }
      ],
      "gates": [
        {
          "on_fail": "phase-analyze",
          "required": [
            "SPEC.md",
            "AC.md"
          ],
          "type": "deliverable_check"
        }
      ],
      "id": "phase-analyze",
      "name": "Requirements Analysis",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ],
      "type": "phase"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/tech-lead.md",
            "ref": "tech-lead",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "tech-lead",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d9k",
            "source": "builtin"
          }
        ],
        "skills": [
          {
            "ref": "protobuf"
          },
          {
            "ref": "api-design"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "R1_DATA_MODEL.md",
          "R2_STATE_MACHINE.md",
          "R3_API_CONTRACT.md"
        ],
        "role": "TechLead"
      },
      "description": "Design data models, state machines, and API contracts",
      "docs": [
        {
          "description": "Data model design including entity relationships and schema definitions",
          "format": "markdown",
          "name": "R1_DATA_MODEL.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/R1_DATA_MODEL.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/architecture-template.md"
        },
        {
          "description": "State machine design defining transitions, events, and lifecycle",
          "format": "markdown",
          "name": "R2_STATE_MACHINE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/R2_STATE_MACHINE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/architecture-template.md"
        },
        {
          "description": "API contract definitions including endpoints, request/response schemas",
          "format": "markdown",
          "name": "R3_API_CONTRACT.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/R3_API_CONTRACT.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/api-issue-template.md"
        }
      ],
      "id": "phase-design",
      "name": "Technical Design",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "design"
        }
      ],
      "type": "phase"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/dev.md",
            "ref": "dev",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "dev",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d5f",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          },
          {
            "ref": "d4e",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-ops"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "code",
          "unit_tests"
        ],
        "role": "Dev"
      },
      "description": "Implement the feature code and unit tests",
      "docs": [
        {
          "description": "Implementation notes documenting key code changes, architectural decisions, and test coverage",
          "format": "markdown",
          "name": "IMPL.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/IMPL.md",
          "required": true
        }
      ],
      "id": "phase-implement",
      "name": "Implementation",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "auto_retry": {
          "delay_minutes": 5,
          "max_attempts": 2
        },
        "conditions": [
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "threshold": "0 errors",
            "type": "lint_pass"
          },
          {
            "type": "no_regressions"
          }
        ],
        "on_fail": "phase-implement",
        "on_pass": "phase-verify"
      },
      "description": "Verify tests pass, lint is clean, and no regressions exist",
      "id": "gate-quality",
      "name": "Quality Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/qa-engineer.md",
            "ref": "qa",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "qa",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d6g",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "TEST_COVERAGE.md"
        ],
        "role": "QA"
      },
      "description": "Run full integration and E2E tests, verify feature completeness",
      "docs": [
        {
          "description": "Test coverage report including unit, integration, and E2E test results",
          "format": "markdown",
          "name": "TEST_COVERAGE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/TEST_COVERAGE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/feature-test-template.md"
        }
      ],
      "id": "phase-verify",
      "name": "Integration Verification",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ],
      "type": "phase"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/tech-lead.md",
            "ref": "tech-lead",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "tech-lead",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d7h",
            "source": "builtin"
          },
          {
            "ref": "d2b",
            "source": "framework"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "SCOPE.md"
        ],
        "role": "TechLead"
      },
      "description": "Review code quality, architecture compliance, and produce SCOPE.md",
      "docs": [
        {
          "content_rules": [
            "Must contain: changed files, added files, deleted files, risk assessment"
          ],
          "description": "Completion scope document summarizing what was implemented, changed, and any known issues",
          "format": "markdown",
          "name": "SCOPE.md",
          "path": "{DOCS_INTERNAL}/{DOC_CATEGORY}/{task_id}/SCOPE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/scope-template.md"
        }
      ],
      "id": "phase-review",
      "name": "Code Review",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "review"
        }
      ],
      "on_exit": [
        {
          "action": "custom",
          "message": "Verify Output Guard 5-step protocol completed",
          "name": "output-guard-check"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "deliverables": [
              "SPEC.md",
              "AC.md",
              "R1_DATA_MODEL.md",
              "R2_STATE_MACHINE.md",
              "R3_API_CONTRACT.md",
              "IMPL.md",
              "TEST_COVERAGE.md",
              "SCOPE.md"
            ],
            "type": "deliverables_complete"
          },
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "threshold": "0 errors",
            "type": "lint_pass"
          },
          {
            "type": "no_regressions"
          },
          {
            "check": "Output Guard Summary all passed",
            "required": true,
            "type": "custom"
          },
          {
            "check": "User confirmation received",
            "required": true,
            "type": "custom"
          },
          {
            "check": "AC Compliance Matrix no failures",
            "required": true,
            "type": "custom"
          },
          {
            "check": "R0_NAVIGATION_MATRIX.md exists and all entries implemented",
            "required": true,
            "type": "custom"
          },
          {
            "check": "SPEC.md and AC.md exist and non-empty",
            "required": true,
            "type": "custom"
          },
          {
            "check": "R1_DATA_MODEL.md exists and non-empty",
            "required": true,
            "type": "custom"
          },
          {
            "check": "R3_API_CONTRACT.md exists and non-empty",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Frontend-backend API paths 100% match",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Frontend-backend param names 100% match",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Frontend-backend response types 100% match",
            "required": true,
            "type": "custom"
          },
          {
            "check": "All Proto APIs have handler registrations",
            "required": true,
            "type": "custom"
          },
          {
            "check": "No Chinese comments in code",
            "required": true,
            "type": "custom"
          },
          {
            "check": "SCOPE.md generated",
            "required": true,
            "type": "custom"
          },
          {
            "check": "TEST_COVERAGE.md exists",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-review",
        "on_pass": "terminal-success"
      },
      "description": "Final gate verifying all deliverables exist, Output Guard passed, and user confirmation received before closing",
      "id": "gate-completion",
      "name": "Completion Gate",
      "type": "gate"
    },
    {
      "config": {
        "message": "Feature development flow completed successfully",
        "status": "success"
      },
      "description": "Feature development completed successfully",
      "id": "terminal-success",
      "name": "Completed",
      "on_exit": [
        {
          "action": "custom",
          "message": "Generate handoff document at session end",
          "name": "handoff-doc"
        }
      ],
      "type": "terminal"
    },
    {
      "config": {
        "message": "Task does not match feature type requirements",
        "status": "rejected"
      },
      "description": "Task rejected at entry gate",
      "id": "terminal-reject",
      "name": "Rejected",
      "type": "terminal"
    }
  ],
  "variables": {
    "DOCS_INTERNAL": "",
    "TEAM_PATH": "",
    "task_id": ""
  },
  "version": "v3"
}
