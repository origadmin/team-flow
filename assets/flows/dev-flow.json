{
  "version": "v3",
  "metadata": {
    "name": "dev-flow",
    "description": "Software development main flow: Triage → Branch by task_type → Feature/Bugfix/Hotfix/Analysis/Change → Terminal",
    "author": "team-flow",
    "tags": [
      "development",
      "main-flow",
      "software"
    ],
    "notes": "Node IDs use short keys (tri3, ent7, etc.) for internal routing uniqueness. Node names are the human-readable display labels. sf-* subflow nodes route to: feature-flow, bugfix-flow, hotfix-flow, analysis-flow, change-flow. batch-flow and release-flow are independent flows and are NOT routed through dev-flow sf-* subflows."
  },
  "config": {
    "task_type": "development",
    "auto_dispatch": true,
    "parallel_limit": 3,
    "timeout_minutes": 480
  },
  "components": {
    "tools": [
      {
        "id": "task",
        "name": "Task CLI",
        "type": "cli",
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ]
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ],
    "skills": [
      {
        "id": "api-design",
        "name": "API Design",
        "source": "builtin",
        "trigger": "manual",
        "path": "{TEAM_PATH}/skills/api-design/SKILL.md",
        "description": "Design RESTful/gRPC API contracts with consistent naming and error handling"
      },
      {
        "id": "protobuf",
        "name": "Protobuf",
        "source": "builtin",
        "trigger": "manual",
        "path": "{TEAM_PATH}/skills/protobuf/SKILL.md",
        "description": "Protocol Buffer schema design and code generation"
      }
    ]
  },
  "nodes": [
    {
      "id": "sta0",
      "type": "start",
      "name": "Session Start",
      "description": "Session start: record context, analyze user intent, create task if needed",
      "entry": true,
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/concierge.md",
            "ref": "concierge",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "concierge",
            "source": "team"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": ["create", "show"]
          },
          {
            "ref": "search"
          }
        ]
      },
      "config": {
        "role": "concierge"
      },
      "on_enter": [
        {
          "action": "exec",
          "command": "flow session start --input \"{{user_input}}\""
        },
        {
          "action": "exec",
          "command": "flow session last --for-ai"
        }
      ],
      "on_exit": [
        {
          "action": "exec",
          "command": "flow session analysis --status {{analysis_status}} --task-type {{task_type}} --task {{task_id}}"
        }
      ]
    },
    {
      "id": "tri3",
      "type": "phase",
      "name": "Task Triage",
      "description": "Classify incoming task by type and dispatch to the appropriate branch",
      "config": {
        "role": "Triage"
      },
      "components": {
        "roles": [
          {
            "ref": "triage",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d1a",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "triage",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/triage.md"
          }
        ]
      },
      "docs": [
        {
          "name": "TRIAGE.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/TRIAGE.md",
          "required": true,
          "description": "Triage classification record with task type, priority, scope assessment, and dispatch decision"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ]
    },
    {
      "id": "ent7",
      "type": "gate",
      "name": "Entry Gate",
      "description": "Validate task has sufficient context and matches a known task type",
      "config": {
        "conditions": [
          {
            "check": "Verify a beads task exists for this request",
            "required": true,
            "type": "task_exists"
          },
          {
            "check": "Task description contains enough detail to proceed",
            "required": true,
            "threshold": "minimal",
            "type": "context_sufficient"
          },
          {
            "check": "Task type can be determined from context",
            "required": false,
            "type": "type_identified"
          }
        ]
      }
    },
    {
      "id": "fa01",
      "type": "phase",
      "name": "Requirements Analysis",
      "description": "Analyze feature requirements and produce specification with acceptance criteria",
      "config": {
        "role": "TechLead"
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d8j",
            "source": "builtin"
          },
          {
            "ref": "d2b",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "skills": [
          {
            "ref": "api-design",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{DOCS_INTERNAL}/{task_id}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "SPEC.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/SPEC.md",
          "template": "{TEAM_PATH}/templates/prd-template.md",
          "required": true,
          "description": "Feature specification: requirements, scope, constraints, data models, API contracts, user journey, navigation, interaction flows",
          "content_rules": [
            "Must contain: overview, requirements, constraints, dependencies",
            "Must contain: user-facing pages with routes, layouts, and component specs (not admin-only)",
            "Must contain: navigation entry points — how users reach each page from existing UI",
            "Must contain: interaction flows for key scenarios (subscribe, upgrade, cancel, etc.) with step-by-step UI transitions",
            "Must contain: state-to-UI mapping — what users see for each business state (active, past_due, expired, etc.)",
            "Must contain: empty/loading/error states for each user-facing page"
          ]
        },
        {
          "name": "AC.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/AC.md",
          "template": "{TEAM_PATH}/templates/prd-template.md",
          "required": true,
          "description": "Acceptance criteria: measurable conditions for feature completion with Given-When-Then format, including UI and navigation criteria",
          "content_rules": [
            "Must contain: acceptance criteria as testable assertions",
            "Each criterion must be verifiable (pass/fail)",
            "Must contain: UI-level acceptance criteria — what user sees and can interact with, not just API responses",
            "Must contain: navigation reachability criteria — every page must be reachable from at least one navigation entry",
            "Must contain: end-to-end user journey criteria — user can complete key flows without dead ends"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "fd02",
      "type": "phase",
      "name": "Technical Design",
      "description": "Design data models, state machines, and API contracts based on requirements",
      "config": {
        "role": "TechLead"
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d9k",
            "source": "builtin"
          }
        ],
        "skills": [
          {
            "ref": "protobuf",
            "source": "builtin"
          },
          {
            "ref": "api-design",
            "source": "builtin"
          }
        ],
        "prompts": [
          {
            "ref": "tech-lead",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/tech-lead.md"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{DOCS_INTERNAL}/{task_id}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "R1_DATA_MODEL.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/R1_DATA_MODEL.md",
          "template": "{TEAM_PATH}/templates/architecture-template.md",
          "required": true,
          "description": "Data model design: entity relationships, schema definitions, index strategy"
        },
        {
          "name": "R2_STATE_MACHINE.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/R2_STATE_MACHINE.md",
          "template": "{TEAM_PATH}/templates/architecture-template.md",
          "required": true,
          "description": "State machine design: transitions, events, lifecycle, error states"
        },
        {
          "name": "R3_API_CONTRACT.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/R3_API_CONTRACT.md",
          "template": "{TEAM_PATH}/templates/api-issue-template.md",
          "required": true,
          "description": "API contract: endpoints, request/response schemas, error codes, versioning"
        },
        {
          "name": "R4_UI_SPEC.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/R4_UI_SPEC.md",
          "required": true,
          "description": "UI specification: frontend routes, navigation, component specs, interaction flows, state-to-UI mapping",
          "content_rules": [
            "Must contain: frontend route definitions for ALL user-facing pages (not admin-only)",
            "Must contain: navigation structure — sidebar/menu items, entry points, breadcrumbs",
            "Must contain: component specs per page — which UI components, form fields, action buttons",
            "Must contain: interaction flow diagrams — step-by-step UI transitions for key scenarios",
            "Must contain: state-to-UI mapping table — business state → displayed UI elements",
            "Must contain: empty state, loading state, error state for each page"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "design"
        }
      ]
    },
    {
      "id": "fi03",
      "type": "phase",
      "name": "Implementation",
      "description": "Implement the feature code and unit tests following the technical design",
      "config": {
        "role": "Dev"
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d5f",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          },
          {
            "ref": "d0l",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-write"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{workspace}/"
            ]
          },
          {
            "type": "tool_restriction",
            "forbidden": [
              "shell-exec"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "IMPL.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/IMPL.md",
          "required": true,
          "description": "Implementation notes: key code changes, architectural decisions, test coverage summary"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "bi01",
      "type": "phase",
      "name": "Root Cause Investigation",
      "description": "Investigate the bug, identify root cause, and produce RCA document",
      "config": {
        "role": "Dev"
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d5f",
            "source": "builtin"
          },
          {
            "ref": "d2b",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ]
      },
      "docs": [
        {
          "name": "RCA.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/RCA.md",
          "template": "{TEAM_PATH}/templates/bug-test-template.md",
          "required": true,
          "description": "Root cause analysis: bug origin, affected components, reproduction steps, severity assessment",
          "content_rules": [
            "Must contain: phenomenon, root_cause, impact, prevention",
            "Data flow trace required for API/permission/state bugs",
            "Real scenario verification required (not mock-only)"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "bf02",
      "type": "phase",
      "name": "Bug Fix",
      "description": "Implement the bug fix and add regression tests",
      "config": {
        "role": "Dev"
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d5f",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-write"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{workspace}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "FIX.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/FIX.md",
          "required": true,
          "description": "Bug fix notes: fix approach, code changes, regression test additions, verification steps"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "hi01",
      "type": "phase",
      "name": "Emergency Fix",
      "description": "Implement the emergency hotfix with minimal scope",
      "config": {
        "role": "Dev"
      },
      "components": {
        "roles": [
          {
            "ref": "dev",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d5f",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-write"
          }
        ],
        "prompts": [
          {
            "ref": "dev",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/dev.md"
          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{workspace}/"
            ]
          },
          {
            "type": "timeout",
            "minutes": 60
          }
        ]
      },
      "docs": [
        {
          "name": "RCA.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/RCA.md",
          "template": "{TEAM_PATH}/templates/bug-test-template.md",
          "required": true,
          "description": "Emergency RCA: incident timeline, root cause, fix description, post-incident actions",
          "content_rules": [
            "Must contain: phenomenon, root_cause, impact, prevention",
            "Data flow trace required for API/permission/state bugs",
            "Real scenario verification required (not mock-only)"
          ]
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ],
      "on_error": {
        "strategy": "fail",
        "on_error": [
          {
            "action": "notify",
            "message": "Hotfix implementation failed - escalation required",
            "channel": "emergency"
          }
        ]
      }
    },
    {
      "id": "ai01",
      "type": "phase",
      "name": "Deep Analysis",
      "description": "Perform technical analysis and gather findings",
      "config": {
        "role": "Analysis"
      },
      "components": {
        "roles": [
          {
            "ref": "analysis",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d2b",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
