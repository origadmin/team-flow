          }
        ],
        "constraints": [
          {
            "type": "file_write",
            "allowed_paths": [
              "{workspace}/"
            ]
          }
        ]
      },
      "docs": [
        {
          "name": "EXEC.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/EXEC.md",
          "required": true,
          "description": "Change execution notes: modifications made, files affected, test updates, verification steps"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ]
    },
    {
      "id": "qua9",
      "type": "gate",
      "name": "Quality Gate",
      "description": "Verify code quality: tests pass, lint clean, no regressions",
      "config": {
        "auto_retry": {
          "delay_minutes": 5,
          "max_attempts": 2
        },
        "conditions": [
          {
            "check": "All unit and integration tests pass",
            "required": true,
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "check": "No lint errors in changed files",
            "required": true,
            "threshold": "0 errors",
            "type": "lint_pass"
          },
          {
            "check": "No regressions in existing functionality",
            "required": false,
