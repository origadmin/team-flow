          }
        ]
      },
      "docs": [
        {
          "name": "REPORT.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/REPORT.md",
          "required": true,
          "description": "Final analysis report: conclusions, recommendations, action items, risk assessment"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "review"
        }
      ]
    },
    {
      "id": "cp01",
      "type": "phase",
      "name": "Change Planning",
      "description": "Plan the change scope, impact analysis, and migration strategy",
      "config": {
        "role": "TechLead"
      },
      "components": {
        "roles": [
          {
            "ref": "tech-lead",
            "source": "team"
          }
        ],
        "rules": [
          {
            "ref": "d9k",
            "source": "builtin"
          },
          {
            "ref": "d2b",
            "source": "framework"
          }
        ],
        "tools": [
          {
            "ref": "task",
            "commands": [
              "show",
              "update",
              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
