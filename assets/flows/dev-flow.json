              "append"
            ]
          },
          {
            "ref": "search"
          }
        ],
        "prompts": [
          {
            "ref": "analysis",
            "source": "file",
            "path": "{TEAM_PATH}/prompts/analysis.md"
          }
        ]
      },
      "docs": [
        {
          "name": "FINDINGS.md",
          "format": "markdown",
          "path": "{DOCS_INTERNAL}/{task_id}/FINDINGS.md",
          "required": true,
          "description": "Analysis findings: investigation results, evidence, patterns, technical insights"
        }
      ],
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "analyze"
        }
      ]
    },
    {
      "id": "ar02",
      "type": "phase",
      "name": "Analysis Report",
      "description": "Compile analysis results into a structured report with conclusions",
      "config": {
        "role": "Analysis"
      },
      "components": {
        "roles": [
          {
            "ref": "analysis",
            "source": "team"
          }
        ],
        "rules": [
          {
